amends "package://github.com/jdx/hk/releases/download/v2.0.1/hk@2.0.1#/Config.pkl"

local elisp_lint = new Step {
  glob = List("herdr*.el")
  exclude = List("herdr*-tests.el")
  check = "eask lint checkdoc --strict {{files}} && eask lint declare --strict {{files}} && eask lint indent --strict {{files}} && eask lint regexps --strict {{files}} && eask lint keywords --strict && eask lint package --strict"
}

hooks {
  ["pre-commit"] {
    steps {
      ["elisp-lint"] = elisp_lint
    }
  }
  ["check"] {
    steps {
      ["elisp-lint"] = elisp_lint
    }
  }
  ["post-checkout"] {
    env {
      ["MISE_CONFIG_DIR"] = "{{ root }}"
    }
    steps {
      ["worktreeinclude"] {
        check = "git worktreeinclude apply --quiet"
      }
    }
  }
}
