#!/bin/sh
# herdr-herd — read and change the herd an agent's pane belongs to.
#
# Membership is pane metadata: a member's pane carries the token `herd',
# naming its herd, reported under the source `herdr-herd'. Neither the
# pane's label nor the agent's name is touched, and peers are addressed by
# pane id. Everything here is `herdr pane report-metadata', `herdr pane
# list' and `herdr agent prompt'; nothing is stored outside herdr, and
# every command below can be typed by hand instead.
#
# A pane argument defaults to $HERDR_PANE_ID, which herdr injects into
# every pane it manages, so an agent addresses itself with no arguments.

set -eu

HERDR=${HERDR_BIN_PATH:-herdr}
SOURCE=herdr-herd

die() {
	printf '%s\n' "$*" >&2
	exit 1
}

usage() {
	cat <<'EOF'
usage: herdr-herd <command> [argument ...]

  list                     every herd and its members as pane, name, status
  members [<herd>]         the members of <herd>, this pane's herd by default
  peers                    the other members of this pane's herd
  of [<pane>]              the herd a pane is in
  join <herd>              put this pane in <herd>
  leave [<pane>]           take a pane out of its herd
  say <message>            send <message> to every idle peer
  tell <pane> <message>    send <message> to one member of this pane's herd

A pane defaults to $HERDR_PANE_ID.
EOF
}

require_pane() {
	if [ -n "${1:-}" ]; then
		printf '%s\n' "$1"
	elif [ -n "${HERDR_PANE_ID:-}" ]; then
		printf '%s\n' "$HERDR_PANE_ID"
	else
		die "no pane given and HERDR_PANE_ID is unset; are you inside a herdr pane?"
	fi
}

# Read every agent as tab-separated PANE, HERD, STATUS, NAME, where NAME
# is the agent's name, else its terminal title, else its kind.
agents() {
	panes=$("$HERDR" pane list)
	list=$("$HERDR" agent list)
	PANES="$panes" AGENTS="$list" python3 -c '
import json, os

panes = json.loads(os.environ["PANES"])["result"]["panes"]
agents = json.loads(os.environ["AGENTS"])["result"]["agents"]

herds = {p.get("pane_id"): (p.get("tokens") or {}).get("herd") or "" for p in panes}

for agent in agents:
    pane = agent.get("pane_id") or ""
    name = (agent.get("name") or agent.get("terminal_title_stripped")
            or agent.get("agent") or "?")
    print("\t".join([
        pane,
        herds.get(pane, ""),
        agent.get("agent_status") or "",
        " ".join(name.split()),
    ]))
'
}

herd_of() {
	pane=$(require_pane "${1:-}")
	agents | awk -F '\t' -v p="$pane" '$1 == p { print $2 }'
}

in_herd() {
	herd=$(herd_of "")
	[ -n "$herd" ] || die "this pane is in no herd"
	printf '%s\n' "$herd"
}

cmd_list() {
	agents | awk -F '\t' '$2 != "" { printf "%s\t%s\t%s\t%s\n", $2, $1, $4, $3 }' |
		sort |
		awk -F '\t' '
			$1 != herd { herd = $1; printf "%s\n", herd }
			{ printf "  %-10s %-32s %s\n", $2, $3, $4 }
		'
}

cmd_members() {
	herd=${1:-}
	[ -n "$herd" ] || herd=$(in_herd)
	agents | awk -F '\t' -v h="$herd" '$2 == h { printf "%-10s %s\n", $1, $4 }'
}

cmd_peers() {
	pane=$(require_pane "")
	herd=$(in_herd)
	agents | awk -F '\t' -v h="$herd" -v p="$pane" \
		'$2 == h && $1 != p { printf "%-10s %s\n", $1, $4 }'
}

cmd_join() {
	herd=${1:-}
	[ -n "$herd" ] || die "usage: herdr-herd join <herd>"
	case $herd in
	*[[:space:]]*) die "a herd name carries no whitespace: $herd" ;;
	esac
	pane=$(require_pane "")
	"$HERDR" pane report-metadata "$pane" --source "$SOURCE" \
		--token "herd=$herd" >/dev/null
	printf '%s is in herd %s\n' "$pane" "$herd"
}

cmd_leave() {
	pane=$(require_pane "${1:-}")
	herd=$(herd_of "$pane")
	[ -n "$herd" ] || die "$pane is in no herd"
	"$HERDR" pane report-metadata "$pane" --source "$SOURCE" \
		--clear-token herd --clear-token herd_id >/dev/null
	printf '%s left herd %s\n' "$pane" "$herd"
}

cmd_say() {
	[ "$#" -gt 0 ] || die "usage: herdr-herd say <message>"
	pane=$(require_pane "")
	herd=$(in_herd)
	agents |
		awk -F '\t' -v h="$herd" -v p="$pane" \
			'$2 == h && $1 != p { print $1 "\t" $3 }' |
		while IFS="$(printf '\t')" read -r peer status; do
			if [ "$status" = working ] || [ "$status" = blocked ]; then
				printf 'skipped %s (%s)\n' "$peer" "$status" >&2
			else
				"$HERDR" agent prompt "$peer" "[$herd] $pane: $*" >/dev/null
				printf 'told %s\n' "$peer"
			fi
		done
}

cmd_tell() {
	[ "$#" -ge 2 ] || die "usage: herdr-herd tell <pane> <message>"
	peer=$1
	shift
	herd=$(in_herd)
	[ "$(herd_of "$peer")" = "$herd" ] || die "$peer is not in herd $herd"
	"$HERDR" agent prompt "$peer" "$*" >/dev/null
	printf 'told %s\n' "$peer"
}

[ "${HERDR_ENV:-}" = 1 ] ||
	die "not inside a herdr pane: HERDR_ENV is not 1"

command -v python3 >/dev/null 2>&1 ||
	die "herdr-herd needs python3 to read herdr's JSON"

command=${1:-}
if [ "$#" -gt 0 ]; then
	shift
fi

case $command in
list) cmd_list ;;
members) cmd_members "${1:-}" ;;
peers) cmd_peers ;;
of) printf '%s\n' "$(herd_of "${1:-}")" ;;
join) cmd_join "${1:-}" ;;
leave) cmd_leave "${1:-}" ;;
say) cmd_say "$@" ;;
tell) cmd_tell "$@" ;;
-h | --help | help | "") usage ;;
*)
	usage >&2
	die "unknown command: $command"
	;;
esac
