#!/bin/sh
set -eu

emacsclient=${EMACSCLIENT:-emacsclient}

usage() {
    printf '%s\n' 'usage: emacsctl operations | call OPERATION [JSON|-] | skill' >&2
    exit 2
}

encode() {
    base64 | tr -d '\n'
}

decode() {
    if printf '' | base64 --decode >/dev/null 2>&1; then
        base64 --decode
    else
        base64 -D
    fi
}

method=
operation=
arguments=

case ${1-} in
    operations)
        [ "$#" -eq 1 ] || usage
        method=operations
        ;;
    call)
        [ "$#" -ge 2 ] && [ "$#" -le 3 ] || usage
        operation=$2
        case $operation in
            [a-z]*.*) ;;
            *) usage ;;
        esac
        case $operation in
            *[!a-z0-9.-]*|.*|*..*|*.) usage ;;
        esac
        method=call
        if [ "$#" -eq 2 ]; then
            arguments='{}'
        elif [ "$3" = '-' ]; then
            arguments=$(command cat)
        else
            arguments=$3
        fi
        [ -n "$arguments" ] || arguments='{}'
        ;;
    skill)
        [ "$#" -eq 1 ] || usage
        method=skill
        ;;
    *) usage ;;
esac

cwd=$PWD
if command -v cygpath >/dev/null 2>&1; then
    cwd=$(cygpath -w "$cwd")
fi
cwd_base64=$(printf '%s' "$cwd" | encode)
case $method in
    call)
        request=$(printf '{"version":1,"method":"call","operation":"%s","arguments":%s,"cwd_base64":"%s"}' \
            "$operation" "$arguments" "$cwd_base64")
        ;;
    *)
        request=$(printf '{"version":1,"method":"%s","cwd_base64":"%s"}' \
            "$method" "$cwd_base64")
        ;;
esac

encoded=$(printf '%s' "$request" | encode)
case $encoded in
    *[!A-Za-z0-9+/=]*)
        printf '%s\n' 'emacsctl: failed to encode request' >&2
        exit 5
        ;;
esac

expression="(progn (require 'emacsctl) (emacsctl-server-dispatch \"$encoded\"))"
if ! response=$("$emacsclient" --eval "$expression"); then
    printf '%s\n' 'emacsctl: local Emacs server or interface unavailable' >&2
    exit 4
fi

response=${response#\"}
response=${response%\"}
case $response in
    [0-9]*:*) ;;
    *)
        printf '%s\n' 'emacsctl: malformed response from Emacs' >&2
        exit 5
        ;;
esac
status=${response%%:*}
payload=${response#*:}
case $status in
    *[!0-9]*|'')
        printf '%s\n' 'emacsctl: malformed response status' >&2
        exit 5
        ;;
esac
case $payload in
    *[!A-Za-z0-9+/=]*)
        printf '%s\n' 'emacsctl: malformed response payload' >&2
        exit 5
        ;;
esac

if ! decoded=$(printf '%s' "$payload" | decode); then
    printf '%s\n' 'emacsctl: malformed response encoding' >&2
    exit 5
fi
printf '%s\n' "$decoded"
exit "$status"
