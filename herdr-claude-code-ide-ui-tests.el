;;; herdr-claude-code-ide-ui-tests.el --- UI workflow tests -*- lexical-binding: t; -*-

(require 'ert)
(require 'cl-lib)
(require 'subr-x)
(require 'herdr-agent nil t)
(require 'herdr-agent-transient nil t)
(require 'herdr-claude-code-ide-mcp)
(require 'herdr-claude-code-ide-transient nil t)
(require 'herdr-claude-code-ide-debug nil t)

(ert-deftest herdr-claude-code-ide-ui-menus-route-agent-workflows-without-a-cli ()
  (dolist (entry-point '(herdr-agent-transient
                         herdr-claude-code-ide-transient))
    (should (commandp entry-point)))
  (let ((protocol-buffer (generate-new-buffer " *herdr-claude-code-ide-protocol*"))
        calls)
    (unwind-protect
        (cl-letf (((symbol-function 'herdr-agent-start)
                   (lambda (kind name &rest _) (push (list 'start kind name) calls)))
                  ((symbol-function 'herdr-agent-continue)
                   (lambda (kind name &rest _) (push (list 'continue kind name) calls)))
                  ((symbol-function 'herdr-agent-resume)
                   (lambda (kind name reference &rest _)
                     (push (list 'resume kind name reference) calls)))
                  ((symbol-function 'herdr-agent-switch)
                   (lambda (target &rest _) (push (list 'switch target) calls)))
                  ((symbol-function 'herdr-agent-prompt)
                   (lambda (target text &rest _) (push (list 'prompt target text) calls)))
                  ((symbol-function 'herdr-agent-stop)
                   (lambda (target &rest _) (push (list 'stop target) calls)))
                  ((symbol-function 'herdr-agent-status)
                   (lambda (target &rest _)
                     (push (list 'status target) calls)
                     (if target
                         '((agent . "pi")
                           (agent_status . "waiting"))
                       '((agent . "claude")
                         (agent_status . "idle")
                         (ide_endpoint . "ws://127.0.0.1:17171")))))
                  ((symbol-function 'herdr-agent-transient-format-status)
                   (lambda (state)
                     (push (list 'format-status state) calls)
                     "formatted status"))
                  ((symbol-function 'herdr-agent-escape)
                   (lambda (target &rest _) (push (list 'escape target) calls)))
                  ((symbol-function 'herdr-claude-code-ide-debug-log-buffer)
                   (lambda () (push '(ide-protocol) calls) protocol-buffer))
                  ((symbol-function 'herdr-claude-code-ide-debug-enable)
                   (lambda () (push '(ide-debug) calls)))
                  ((symbol-function 'pop-to-buffer)
                   (lambda (&rest _) nil))
                  ((symbol-function 'customize-group)
                   (lambda (group &rest _) (push (list 'customize group) calls)))
                  ((symbol-function 'start-process)
                   (lambda (&rest _) (error "UI actions must not spawn a process")))
                  ((symbol-function 'process-file)
                   (lambda (&rest _) (error "UI actions must not spawn a process")))
                  ((symbol-function 'call-process)
                   (lambda (&rest _) (error "UI actions must not spawn a process")))
                  ((symbol-function 'shell-command)
                   (lambda (&rest _) (error "UI actions must not invoke a shell"))))
          (dolist (call '((herdr-agent-transient-start "claude" "review")
                          (herdr-agent-transient-continue "pi" "review")
                          (herdr-agent-transient-resume "codex" "review" "resume-7")
                          (herdr-agent-transient-switch "term-7")
                          (herdr-agent-transient-prompt "term-7" "(+ 1 1)")
                          (herdr-agent-transient-stop "term-7")
                          (herdr-agent-transient-escape "term-7")
                          (herdr-agent-transient-customize)
                          (herdr-agent-transient-status "term-7")
                          (herdr-claude-code-ide-transient-status)
                          (herdr-claude-code-ide-transient-protocol)
                          (herdr-claude-code-ide-transient-debug)))
            (apply (car call) (cdr call)))
          (let ((calls (nreverse calls)))
            (should (equal (mapcar (lambda (call)
                                     (if (eq (car call) 'format-status)
                                         '(format-status)
                                       call))
                                   calls)
                           '((start "claude" "review")
                             (continue "pi" "review")
                             (resume "codex" "review" "resume-7")
                             (switch "term-7")
                             (prompt "term-7" "(+ 1 1)")
                             (stop "term-7")
                             (escape "term-7")
                             (customize herdr)
                             (status "term-7")
                             (format-status)
                             (status nil)
                             (format-status)
                             (ide-protocol)
                             (ide-debug))))
            (pcase-let ((`(,generic-state ,claude-state)
                         (mapcar #'cadr
                                 (seq-filter (lambda (call)
                                               (eq (car call) 'format-status))
                                             calls))))
              (dolist (field '((:kind . "pi")
                               (:harness . "Pi")
                               (:herdr . connected)
                               (:agent . waiting)))
                (should (equal (plist-get generic-state (car field)) (cdr field))))
              (dolist (field '(:ide :ide-endpoint))
                (should-not (plist-member generic-state field)))
              (dolist (field '((:kind . "claude")
                               (:harness . "Claude Code")
                               (:herdr . connected)
                               (:agent . idle)
                               (:ide . connected)
                               (:ide-endpoint . "ws://127.0.0.1:17171")))
                (should (equal (plist-get claude-state (car field)) (cdr field)))))))
          (let ((entry '((server_key . "server-a") (terminal_id . "term-7"))))
            (cl-letf (((symbol-function 'herdr-sessions)
                       (lambda () (list entry)))
                      ((symbol-function 'herdr-read-entry)
                       (lambda (_prompt entries &rest _)
                         (should (equal entries (list entry)))
                         entry))
                      ((symbol-function 'read-string)
                       (lambda (&rest _)
                         (error "target actions must select a session entry")))
                      ((symbol-function 'herdr-agent-switch)
                       (lambda (target &rest _)
                         (setq calls (list (list 'switch target))))))
              (call-interactively #'herdr-agent-transient-switch))
            (should (equal calls '((switch ("server-a" . "term-7"))))))
      (kill-buffer protocol-buffer))))

(ert-deftest herdr-claude-code-ide-ui-status-formatting-is-agent-specific ()
  (should (fboundp 'herdr-agent-transient-format-status))
  (dolist (expectation
           '(((:kind "claude" :harness "Claude Code" :herdr connected
              :agent idle :ide connected
              :ide-endpoint "ws://127.0.0.1:17171")
              "Claude Code" "Herdr: connected" "Agent: idle" "IDE: connected"
              "ws://127.0.0.1:17171")
             ((:kind "pi" :harness "Pi" :herdr connected :agent waiting)
              "Pi" "Herdr: connected" "Agent: waiting")
             ((:kind "codex" :harness "Codex" :herdr disconnected :agent stopped)
              "Codex" "Herdr: disconnected" "Agent: stopped")))
    (pcase-let ((`(,state . ,fragments) expectation))
      (let ((view (funcall (intern "herdr-agent-transient-format-status") state)))
        (should (stringp view))
        (dolist (fragment fragments)
          (should (string-match-p (regexp-quote fragment) view)))
        (unless (equal (plist-get state :kind) "claude")
          (should-not (string-match-p "IDE:" view)))))))

(ert-deftest herdr-claude-code-ide-ui-raw-logging-is-an-opt-in-custom-option ()
  (should (boundp 'herdr-claude-code-ide-raw-protocol-logging))
  (should (custom-variable-p 'herdr-claude-code-ide-raw-protocol-logging))
  (should-not (default-value 'herdr-claude-code-ide-raw-protocol-logging))
  (let ((documentation
         (documentation-property 'herdr-claude-code-ide-raw-protocol-logging
                                 'variable-documentation)))
    (should (stringp documentation))
    (should (string-match-p "raw\\|payload\\|protocol" documentation))
    (should (string-match-p "expos\\|sensitive\\|risk\\|private" documentation))))

(ert-deftest herdr-claude-code-ide-ui-raw-logging-keeps-context-and-cleans-up ()
  (dolist (workflow '(herdr-claude-code-ide-debug-enable
                      herdr-claude-code-ide-debug-disable))
    (should (commandp workflow)))
  (should (fboundp 'herdr-claude-code-ide-debug-log-buffer))
  (let* ((original (default-value 'herdr-claude-code-ide-raw-protocol-logging))
         (session (herdr-agent--make-session))
         (session-key '("adapter-a" . "session-a"))
         (raw-client '((private-state . "private-state-sentinel")))
         (client (make-herdr-claude-code-ide-mcp-client
                  :raw raw-client :open-p t :initialized-p t :generation 1))
         (adapter (make-herdr-claude-code-ide-mcp-adapter
                   :session-key session-key :session session :state 'connected
                   :clients (list client) :current-client client :client-generation 1))
         (incoming "{\"jsonrpc\":\"2.0\",\"method\":\"notifications/initialized\"}")
         (response '((jsonrpc . "2.0") (id . 7) (result . ((ok . t)))))
         (outgoing (json-serialize response))
         (collision-name "*herdr-claude-code-ide-protocol*")
         (collision (get-buffer collision-name))
         (collision-created-p (null collision))
         (collision (or collision (generate-new-buffer collision-name)))
         (collision-contents (with-current-buffer collision (buffer-string)))
         sent log-buffer incoming-observed outgoing-observed
         (veto (lambda () nil))
         (incoming-sentinel
          (lambda (seen-adapter seen-client payload)
            (push (list seen-adapter seen-client payload) incoming-observed)))
         (outgoing-sentinel
          (lambda (seen-adapter seen-client payload)
            (push (list seen-adapter seen-client payload) outgoing-observed)))
         (incoming-record
          (format "incoming adapter=%S generation=%d %s\n"
                  session-key 1 incoming))
         (outgoing-record
          (format "outgoing adapter=%S generation=%d %s\n"
                  session-key 1 outgoing)))
    (setf (herdr-agent-session-key session) session-key
          (herdr-agent-session-kind session) "claude")
    (add-hook 'herdr-claude-code-ide-mcp--incoming-observers incoming-sentinel)
    (add-hook 'herdr-claude-code-ide-mcp--outgoing-observers outgoing-sentinel)
    (unwind-protect
        (cl-letf (((symbol-function 'websocket-send-text)
                   (lambda (_socket payload) (push payload sent))))
          (let ((buffers (buffer-list)))
            (herdr-claude-code-ide-mcp-receive adapter client incoming)
            (herdr-claude-code-ide-mcp-send-deferred client response)
            (should (equal (car sent) outgoing))
            (should (equal buffers (buffer-list))))
          (customize-set-variable 'herdr-claude-code-ide-raw-protocol-logging t)
          (herdr-claude-code-ide-mcp-receive adapter client incoming)
          (herdr-claude-code-ide-mcp-send-deferred client response)
          (should (equal (car sent) outgoing))
          (setq log-buffer
                (funcall (intern "herdr-claude-code-ide-debug-log-buffer")))
          (should (equal (buffer-name collision) collision-name))
          (should-not (eq log-buffer collision))
          (with-current-buffer log-buffer
            (let ((contents (buffer-string)))
              (should (string-match-p (regexp-quote incoming-record) contents))
              (should (string-match-p (regexp-quote outgoing-record) contents))
              (should-not (string-match-p "private-state-sentinel" contents))))
          (with-current-buffer collision
            (should (equal (buffer-string) collision-contents)))
          (with-current-buffer log-buffer
            (rename-buffer
             (generate-new-buffer-name " *herdr-claude-code-ide-protocol-renamed*")))
          (with-current-buffer log-buffer
            (add-hook 'kill-buffer-query-functions veto nil t))
          (customize-set-variable 'herdr-claude-code-ide-raw-protocol-logging nil)
          (should-not (memq #'herdr-claude-code-ide-debug--incoming
                            herdr-claude-code-ide-mcp--incoming-observers))
          (should-not (memq #'herdr-claude-code-ide-debug--outgoing
                            herdr-claude-code-ide-mcp--outgoing-observers))
          (should (memq incoming-sentinel
                        herdr-claude-code-ide-mcp--incoming-observers))
          (should (memq outgoing-sentinel
                        herdr-claude-code-ide-mcp--outgoing-observers))
          (should (buffer-live-p log-buffer))
          (should (eq herdr-claude-code-ide-debug--log-buffer log-buffer))
          (should (buffer-live-p collision))
          (with-current-buffer collision
            (should (equal (buffer-string) collision-contents)))
          (with-current-buffer log-buffer
            (remove-hook 'kill-buffer-query-functions veto t))
          (funcall (intern "herdr-claude-code-ide-debug-disable"))
          (should-not (buffer-live-p log-buffer))
          (should-not herdr-claude-code-ide-debug--log-buffer)
          (funcall (intern "herdr-claude-code-ide-debug-disable"))
          (setq incoming-observed nil
                outgoing-observed nil)
          (let ((buffers (buffer-list)))
            (herdr-claude-code-ide-mcp-receive adapter client incoming)
            (herdr-claude-code-ide-mcp-send-deferred client response)
            (should (equal buffers (buffer-list))))
          (should (equal incoming-observed
                         (list (list adapter client incoming))))
          (should (equal outgoing-observed
                         (list (list adapter client outgoing)))))
      (remove-hook 'herdr-claude-code-ide-mcp--incoming-observers incoming-sentinel)
      (remove-hook 'herdr-claude-code-ide-mcp--outgoing-observers outgoing-sentinel)
      (when (buffer-live-p log-buffer)
        (with-current-buffer log-buffer
          (remove-hook 'kill-buffer-query-functions veto t)))
      (customize-set-variable 'herdr-claude-code-ide-raw-protocol-logging original)
      (when (fboundp 'herdr-claude-code-ide-debug-disable)
        (funcall (intern "herdr-claude-code-ide-debug-disable")))
      (when (buffer-live-p log-buffer)
        (kill-buffer log-buffer))
      (when (and collision-created-p (buffer-live-p collision))
        (kill-buffer collision)))))

(provide 'herdr-claude-code-ide-ui-tests)
