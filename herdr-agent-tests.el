(ert-deftest herdr-agent-native-start-continue-and-resume-use-harness-arguments ()
  (herdr-agent-tests--require-functions
   'herdr-agent-start 'herdr-agent-continue 'herdr-agent-resume)
  (let* ((root (make-temp-file "herdr-agent-native-launch" t))
         (server-key (expand-file-name "herdr.sock" root))
         (attachments nil)
         (starts nil)
         sessions)
    (unwind-protect
        (cl-letf (((symbol-function 'herdr-start-server-if-needed)
                   (lambda (&rest _) t))
                  ((symbol-function 'herdr-workspace-id)
                   (lambda (&rest _) "work"))
                  ((symbol-function 'herdr-api-tab-create)
                   (lambda (&rest _)
                     '((tab . ((tab_id . "work:tab") (workspace_id . "work")))
                       (root_pane . ((pane_id . "work:tab:root")
                                     (tab_id . "work:tab")
                                     (workspace_id . "work"))))))
                  ((symbol-function 'herdr-api-agent-start)
                   (lambda (kind name pane-id &rest arguments)
                     (push (list kind name pane-id arguments) starts)
                     `((agent . ,(herdr-agent-tests--agent
                                  kind (concat pane-id ":terminal") pane-id "work")))))
                  ((symbol-function 'herdr-attach-terminal)
                   (lambda (terminal-id &rest _)
                     (let ((attachment
                            (herdr-agent-tests--attachment terminal-id terminal-id)))
                       (push attachment attachments)
                       (car attachment)))))
          (dolist (harness (herdr-agent-tests--harnesses))
            (let* ((kind (alist-get 'kind harness))
                   (reference (format "%s-session" kind)))
              (push (herdr-agent-start kind "review"
                                       :server-key server-key :project-root root)
                    sessions)
              (push (herdr-agent-continue kind "review"
                                          :server-key server-key :project-root root)
                    sessions)
              (push (herdr-agent-resume kind "review" reference
                                        :server-key server-key :project-root root)
                    sessions)
              (setq starts (nreverse starts))
              (should (equal (mapcar (lambda (call)
                                       (list (car call) (nth 3 call)))
                                     starts)
                             (mapcar
                              (lambda (action)
                                (list kind
                                      (list :args
                                            (herdr-agent-tests--harness-arguments
                                             harness action reference))))
                              '(start continue resume))))
              (setq starts nil)
              (should-error
               (herdr-agent-resume kind "review" nil
                                   :server-key server-key :project-root root)
               :type 'user-error)
              (should-not starts)))
      (mapc #'herdr-agent-tests--detach sessions)
      (mapc #'herdr-agent-tests--dispose-attachment attachments)
      (delete-directory root t)))))

(ert-deftest herdr-agent-native-target-resolution-is-explicit-project-local-and-mru ()
  (herdr-agent-tests--require-functions 'herdr-agent-resolve-target)
  (let* ((project "/projects/alpha/")
         (agents '(((terminal_id . "foreign") (agent . "aider")
                   (cwd . "/projects/beta/"))
                  ((terminal_id . "alpha-old") (agent . "pi")
                   (cwd . "/projects/alpha/"))
                  ((terminal_id . "alpha-recent") (agent . "claude")
                   (cwd . "/projects/alpha/lib/"))))
         (mru '("foreign" "alpha-recent"))
         (picker-used nil))
    (cl-letf (((symbol-function 'completing-read)
               (lambda (&rest _) (setq picker-used t) "foreign")))
      (should (equal (alist-get 'terminal_id
                                (herdr-agent-resolve-target "foreign" agents project mru))
                     "foreign"))
      (should (equal (alist-get 'terminal_id
                                (herdr-agent-resolve-target nil agents project mru))
                     "alpha-recent"))
      (should-error (herdr-agent-resolve-target "missing" agents project mru)
                    :type 'user-error)
      (should-error (herdr-agent-resolve-target nil agents project nil)
                    :type 'user-error)
      (should-not picker-used))))

(ert-deftest herdr-agent-native-management-uses-herdr-api-wrappers ()
  (herdr-agent-tests--require-functions
   'herdr-agent-list 'herdr-agent-switch 'herdr-agent-rename
   'herdr-agent-status 'herdr-agent-stop 'herdr-agent-stop-all)
  (let* ((agents '(((terminal_id . "term-a") (pane_id . "w:p-a")
                    (agent . "claude") (name . "review"))
                   ((terminal_id . "term-b") (pane_id . "w:p-b")
                    (agent . "aider") (name . "generic"))))
         (calls nil))
    (cl-letf (((symbol-function 'herdr-api-agent-list)
               (lambda () (push '(list) calls) `((agents . ,agents))))
              ((symbol-function 'herdr-api-agent-focus)
               (lambda (target) (push (list 'focus target) calls)))
              ((symbol-function 'herdr-api-agent-rename)
               (lambda (target &rest arguments)
                 (push (list 'rename target arguments) calls)))
              ((symbol-function 'herdr-api-agent-get)
               (lambda (target)
                 (push (list 'get target) calls)
                 (if-let ((agent (cl-find target agents :key (lambda (agent)
                                                              (alist-get 'terminal_id agent))
                                         :test #'equal)))
                     `((agent . ,agent))
                   (signal 'user-error (list "unknown agent")))))
              ((symbol-function 'herdr-api-pane-close)
               (lambda (pane-id) (push (list 'close pane-id) calls)))
              ((symbol-function 'herdr--terminal-exec)
               #'herdr-agent-tests--unexpected-cli)
              ((symbol-function 'start-process)
               #'herdr-agent-tests--unexpected-cli)
              ((symbol-function 'process-file)
               #'herdr-agent-tests--unexpected-cli)
              ((symbol-function 'call-process)
               #'herdr-agent-tests--unexpected-cli)
              ((symbol-function 'shell-command)
               #'herdr-agent-tests--unexpected-cli)
              ((symbol-function 'call-process-shell-command)
               #'herdr-agent-tests--unexpected-cli))
      (should (equal (herdr-agent-list) agents))
      (herdr-agent-rename "term-a" "renamed")
      (herdr-agent-status "term-a")
      (herdr-agent-stop "term-a")
      (setq calls (nreverse calls))
      (should (member '(rename "term-a" (:name "renamed")) calls))
      (should (member '(get "term-a") calls))
      (should (member '(close "w:p-a") calls))
      (should-not (member '(close "w:p-b") calls))
      (setq calls nil)
      (herdr-agent-stop-all)
      (setq calls (nreverse calls))
      (should (member '(close "w:p-a") calls))
      (should (member '(close "w:p-b") calls)))))

