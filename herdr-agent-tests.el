(ert-deftest herdr-agent-native-management-uses-herdr-api-wrappers ()
  (herdr-agent-tests--require-functions
   'herdr-agent-list 'herdr-agent-switch 'herdr-agent-rename
   'herdr-agent-status 'herdr-agent-stop 'herdr-agent-stop-all
   'herdr-agent-adopt 'herdr-agent-detach)
  (let* ((agents '(((terminal_id . "term-a") (pane_id . "w:p-a")
                    (agent . "claude") (name . "review"))
                   ((terminal_id . "term-b") (pane_id . "w:p-b")
                    (agent . "aider") (name . "generic"))))
         (calls nil)
         (herdr-agent-harnesses
          (herdr-agent-tests--with-adapter "claude" nil)))
    (cl-letf (((symbol-function 'herdr-attach-terminal)
               (lambda (terminal-id &rest _)
                 (generate-new-buffer (format " *herdr-agent-%s*" terminal-id))))
              ((symbol-function 'herdr-api-agent-list)
               (lambda () (push '(list) calls) `((agents . ,agents))))
              ((symbol-function 'herdr-api-agent-focus)
               (lambda (target) (push (list 'focus target) calls)))
              ((symbol-function 'herdr-api-agent-rename)
               (lambda (target &rest arguments)
                 (push (list 'rename target arguments) calls)))
              ((symbol-function 'herdr-api-agent-get)
               (lambda (target)
                 (push (list 'get target) calls)
                 (if-let ((agent (cl-find target agents :key (lambda (agent)
                                                              (alist-get 'terminal_id agent))
                                         :test #'equal)))
                     `((agent . ,agent))
                   (signal 'user-error (list "unknown agent")))))
              ((symbol-function 'herdr-api-pane-close)
               (lambda (pane-id) (push (list 'close pane-id) calls)))
              ((symbol-function 'herdr--terminal-exec)
               #'herdr-agent-tests--unexpected-cli)
              ((symbol-function 'start-process)
               #'herdr-agent-tests--unexpected-cli)
              ((symbol-function 'process-file)
               #'herdr-agent-tests--unexpected-cli)
              ((symbol-function 'call-process)
               #'herdr-agent-tests--unexpected-cli)
              ((symbol-function 'shell-command)
               #'herdr-agent-tests--unexpected-cli)
              ((symbol-function 'call-process-shell-command)
               #'herdr-agent-tests--unexpected-cli))
      (should (equal (herdr-agent-list) agents))
      (herdr-agent-rename "term-a" "renamed")
      (herdr-agent-status "term-a")
      (herdr-agent-stop "term-a")
      (setq calls (nreverse calls))
      (should (member '(rename "term-a" (:name "renamed")) calls))
      (should (member '(get "term-a") calls))
      (should (member '(close "w:p-a") calls))
      (should-not (member '(close "w:p-b") calls))
      (setq calls nil)
      (herdr-agent-stop-all)
      (setq calls (nreverse calls))
      (should (member '(close "w:p-a") calls))
      (should (member '(close "w:p-b") calls))
      (let ((fresh-unregistered
             '((terminal_id . "terminal-unregistered")
               (pane_id . "fresh:pane") (name . "fresh-name")
               (agent . "claude"))))
        (setq agents (list fresh-unregistered)
              calls nil)
        (cl-letf (((symbol-function 'herdr-api-agent-get)
                   (lambda (target)
                     (push (list 'get target) calls)
                     (if (member target '("terminal-unregistered" "terminal-renamed"))
                         (signal 'herdr-api-error '("agent_not_found"))
                       `((agent . ,(cl-find target agents
                                             :key (lambda (agent)
                                                    (alist-get 'pane_id agent))
                                             :test #'equal)))))))
          (should (equal (herdr-agent-status "terminal-unregistered")
                         fresh-unregistered))
          (let* ((root (make-temp-file "herdr-agent-management" t))
                 (socket (expand-file-name "herdr.sock" root))
                 server-key
                 (stale-agent
                  '((terminal_id . "terminal-renamed")
                    (pane_id . "stale:pane") (name . "stale-name")
                    (agent . "claude")))
                 (fresh-renamed
                  '((terminal_id . "terminal-renamed")
                    (pane_id . "fresh-renamed:pane") (name . "fresh-renamed")
                    (agent . "claude")))
                 session)
            (unwind-protect
                (progn
                  (make-empty-file socket)
                  (let ((herdr-socket-path socket))
                    (setq server-key (herdr-server-key)))
                  (setq session
                        (herdr-agent-adopt stale-agent :server-key server-key :attach nil))
                  (cl-letf (((symbol-function 'herdr-api-agent-list)
                           (lambda ()
                             (unless (equal herdr-socket-path server-key)
                               (error "wrong-server lookup"))
                             (push (list herdr-socket-path 'list) calls)
                             `((agents . ,agents))))
                          ((symbol-function 'herdr-api-agent-get)
                           (lambda (target)
                             (unless (equal herdr-socket-path server-key)
                               (error "wrong-server lookup"))
                             (push (list herdr-socket-path 'get target) calls)
                             (cond
                              ((member target '("terminal-unregistered" "terminal-renamed"
                                               "fresh-renamed:pane"))
                               (signal 'herdr-api-error '("agent_not_found")))
                              ((equal target "fresh:pane")
                               `((agent . ,fresh-unregistered)))
                              ((equal target "fresh-renamed")
                               `((agent . ,fresh-renamed)))
                              (t (error "unexpected lookup: %s" target)))))
                          ((symbol-function 'herdr-api-pane-close)
                           (lambda (pane-id)
                             (unless (equal herdr-socket-path server-key)
                               (error "wrong-server close"))
                             (push (list herdr-socket-path 'close pane-id) calls))))
              (setq agents (list fresh-renamed))
              (should (equal (herdr-agent-session-key session)
                             (cons server-key "terminal-renamed")))
              (should (equal (herdr-agent-status
                              (cons server-key "terminal-renamed"))
                             fresh-renamed))
              (should (eq (herdr-agent-find server-key "terminal-renamed") session))
              (should (equal (herdr-agent-session-pane session) "fresh-renamed:pane"))
              (should (equal (herdr-agent-session-name session) "fresh-renamed"))
              (herdr-agent-stop (cons server-key "terminal-renamed"))
              (should (member (list server-key 'close "fresh-renamed:pane") calls)))
              (herdr-agent-detach session))
          (progn
            (let ((calls (nreverse calls)))
              (let ((owned-terminal-get
                     (cl-position (list server-key 'get "terminal-renamed") calls
                                  :test #'equal))
                    (owned-list (cl-position (list server-key 'list) calls :test #'equal))
                    (fresh-pane-get
                     (cl-position (list server-key 'get "fresh-renamed:pane") calls
                                  :test #'equal))
                    (fresh-name-get
                     (cl-position (list server-key 'get "fresh-renamed") calls
                                  :test #'equal))
                    (refreshed-close
                     (cl-position (list server-key 'close "fresh-renamed:pane") calls
                                  :test #'equal)))
                (should owned-terminal-get)
                (should owned-list)
                (should fresh-pane-get)
                (should fresh-name-get)
                (should refreshed-close)
                (should (< owned-terminal-get owned-list))
                (should (< owned-list fresh-pane-get))
                (should (< fresh-pane-get fresh-name-get))
                (should (< fresh-name-get refreshed-close))))
            (delete-directory root t)))))))))

