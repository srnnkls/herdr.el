            (should (eq (herdr-agent-session-state startup-session) 'attached))
            (should (equal (herdr-agent-status
                           (herdr-agent-session-key startup-session))
                           '((integration_status . "published"))))
            (should (= attached-count 1))
            (should (equal attached-terminals '("term-startup-1")))
            (should-not (herdr-agent-session-ownership startup-session))
            (should-not (herdr-agent-session-buffer startup-session))
            (should-not (herdr-agent-session-attachment-process startup-session))
            (should
             (equal (cl-subseq (nreverse operations) 0 9)
                    '(subscribe subscribe subscribe subscribe subscribe prepare topology
                      agent-start attached)))
            (should (equal (pop prepared-subscription-states) '(5 t)))
            (setq operations nil)
            (herdr-agent-detach startup-session)
            (should-not (memq 'tab-close operations))
            (should-not (memq 'workspace-close operations))
            (should (eq (herdr-agent-session-state startup-session) 'stopped))
            (puthash server-a '(nil) herdr-agent--subscriptions)
            (setq operations nil
                  nil-subscription-session
                  (herdr-agent-start-session "pi" "nil-subscription"
                                             :server-key server-a :project-root root
                                             :attach nil))
            (should
             (equal (cl-subseq (nreverse operations) 0 9)
                    '(subscribe subscribe subscribe subscribe subscribe prepare topology
                      agent-start attached)))
            (should (equal (pop prepared-subscription-states) '(5 t)))
            (funcall (gethash (cons server-a "pane.updated") callbacks)
                     `((pane . ,(herdr-agent-tests--pane "claude" "term-shared" "a:old" "a"))))
            (funcall (gethash (cons server-a "pane.moved") callbacks)
                     `((previous_pane_id . "a:old")
                       (previous_workspace_id . "a")
                       (previous_tab_id . "a:tab-1")
                       (pane . ,(herdr-agent-tests--pane "claude" "term-shared" "a:new" "a"))))
            (funcall (gethash (cons server-a "pane.agent_detected") callbacks)
                     '((pane_id . "a:new") (workspace_id . "a")))
            (should (eq (herdr-agent-find server-a "term-shared") session-a))
            (funcall (gethash (cons server-a "pane.agent_detected") callbacks)
                     '((pane_id . "a:new") (workspace_id . "a") (released . t)))
            (should-not (herdr-agent-find server-a "term-shared"))
            (funcall (gethash (cons server-a "pane.exited") callbacks)
                     '((pane_id . "a:new") (workspace_id . "a")))
            (should-not (herdr-agent-find server-a "term-shared"))
            (funcall (gethash (cons server-a "pane.closed") callbacks)
                     '((pane_id . "a:gone") (workspace_id . "a")))
            (should (eq (herdr-agent-find server-b "term-shared") session-b))
            (let* ((canonical-root (expand-file-name "canonical" root))
                   (alias-root (expand-file-name "alias" root))
                   (canonical-socket (expand-file-name "herdr.sock" canonical-root))
                   (alias-socket (expand-file-name "herdr.sock" alias-root))
                   (agent (herdr-agent-tests--agent
                           "claude" "canonical-terminal" "canonical:pane" "canonical"))
                   canonical-server)
              (make-directory canonical-root t)
              (make-empty-file canonical-socket)
              (make-symbolic-link canonical-root alias-root)
              (let ((herdr-socket-path canonical-socket))
                (setq canonical-server (herdr-server-key)))
              (setq alias-session
                    (herdr-agent-adopt agent :server-key alias-socket :attach nil))
              (should (equal (herdr-agent-session-key alias-session)
                             (cons canonical-server "canonical-terminal")))
              (should (eq (herdr-agent-find canonical-server "canonical-terminal")
                          alias-session))
              (should (eq (herdr-agent-find alias-socket "canonical-terminal")
                          alias-session))
              (let ((herdr-socket-path canonical-socket))
                (herdr-agent-subscribe canonical-server))
              (funcall (gethash (cons canonical-server "pane.exited") callbacks)
                       '((pane_id . "canonical:pane") (workspace_id . "canonical")))
              (should (eq (herdr-agent-session-state alias-session) 'stopped))
              (should-not (herdr-agent-find canonical-server "canonical-terminal"))
              (should-not (herdr-agent-find alias-socket "canonical-terminal")))))
      (herdr-agent-tests--detach session-a)
      (herdr-agent-tests--detach session-b)
      (herdr-agent-tests--detach alias-session)
      (herdr-agent-tests--detach startup-session)
      (herdr-agent-tests--detach nil-subscription-session)
      (dolist (entry subscription-processes)
        (when (process-live-p (cdr entry))
          (delete-process (cdr entry))))
      (mapc #'herdr-agent-tests--dispose-attachment attachments)
      (delete-directory root t))))

(ert-deftest herdr-agent-detach-and-attachment-death-keep-herdr-open-and-retry-cleanup ()
  (let* ((herdr-agent-harnesses
          (herdr-agent-tests--with-adapter "claude" nil))
         (root (make-temp-file "herdr-agent-detach" t))
         (server-key (expand-file-name "herdr.sock" root))
         (attachments nil)
         (subscription-processes nil)
         (requests nil)
         dead-session retry-session)
    (unwind-protect
        (cl-letf (((symbol-function 'herdr-attach-terminal)
                   (lambda (terminal-id &rest _)
                     (let ((attachment
                            (herdr-agent-tests--attachment terminal-id terminal-id)))
                       (push attachment attachments)
                       (car attachment))))
                  ((symbol-function 'herdr-request)
                   (lambda (method &rest _)
                     (push method requests)
                     '((type . "ok"))))
                  ((symbol-function 'herdr-subscribe)
                   (lambda (&rest _)
                     (let ((process
                            (start-process "herdr-agent-subscription" nil "sleep" "30")))
                       (push process subscription-processes)
                       process))))
          (setq dead-session
                (herdr-agent-adopt
                 (herdr-agent-tests--agent "codex" "term-death" "death:pane" "work")
                 :server-key server-key))
          (delete-process (herdr-agent-session-attachment-process dead-session))
          (accept-process-output nil 0.05)
          (should (eq (herdr-agent-session-state dead-session) 'stopped))
          (should-not (herdr-agent-find server-key "term-death"))
          (should-not requests)
          (let* ((terminal-id "term-publication-race")
                 (ownership (list :workspace "work"))
                 (adapter-ran nil)
                 (rollback-count 0)
                 rollback-entry-state rollback-entry-ownership
                 (registration-count 0)
                 (attachment (herdr-agent-tests--attachment terminal-id terminal-id))
                 (buffer (car attachment))
                 (process (cdr attachment))
                 (session (herdr-agent--make-session
                           :key (cons server-key terminal-id)
                           :server server-key :terminal terminal-id :kind "claude"
                           :buffer buffer :attachment-process process
                           :state 'starting :ownership ownership))
                 (original-rollback (symbol-function 'herdr-agent--rollback))
                 (original-register (symbol-function 'herdr-agent--register))
                 (original-set-process-sentinel (symbol-function 'set-process-sentinel))
                 (sentinel-installed nil))
            (push attachment attachments)
            (let ((herdr-agent-harnesses
                   (herdr-agent-tests--with-adapter
                    "claude"
                    (lambda (_session phase &optional _context)
                      (when (eq phase :attached)
                        (setq adapter-ran t))))))
              (cl-letf (((symbol-function 'herdr-agent--rollback)
                         (lambda (candidate)
                           (cl-incf rollback-count)
                           (setq rollback-entry-state (herdr-agent-session-state candidate)
                                 rollback-entry-ownership
                                 (copy-tree (herdr-agent-session-ownership candidate)))
                           (funcall original-rollback candidate)))
                        ((symbol-function 'herdr-agent--register)
                         (lambda (candidate)
                           (cl-incf registration-count)
                           (funcall original-register candidate)))
                        ((symbol-function 'set-process-sentinel)
                         (lambda (candidate sentinel)
                           (funcall original-set-process-sentinel candidate sentinel)
                           (when (and (eq candidate process) (not sentinel-installed))
                             (setq sentinel-installed t)
                             (delete-process process)))))
                (should-error (herdr-agent-claim-attachment session buffer process)
                              :type 'herdr-error)))
            (should sentinel-installed)
            (should (= registration-count 0))
            (should (= rollback-count 1))
            (should (eq rollback-entry-state 'starting))
            (should (equal rollback-entry-ownership '(:workspace "work")))
            (should-not adapter-ran)
            (should-not (herdr-agent-session-ownership session))
            (should (eq (herdr-agent-session-state session) 'stopped))
            (should-not (eq (herdr-agent-session-state session) 'attached))
            (should-not (herdr-agent-find server-key terminal-id)))
          (let* ((terminal-id nil)
                 (published nil)
                 (installed nil)
                 (adapter-error nil)
                 (adapter-session nil)
                 (original-set-process-sentinel (symbol-function 'set-process-sentinel))
                 (herdr-agent-harnesses
                  (herdr-agent-tests--with-adapter
                   "claude"
                   (lambda (session phase &optional _context)
                     (when (and (eq phase :attached)
                                (equal (herdr-agent-session-terminal session)
                                       "term-adapter-death"))
                       (delete-process
                        (herdr-agent-session-attachment-process session)))))))
            (cl-letf (((symbol-function 'herdr-attach-terminal)
                       (lambda (candidate &rest _)
                         (let ((attachment
                                (herdr-agent-tests--attachment candidate candidate)))
                           (push attachment attachments)
                           (car attachment))))
                      ((symbol-function 'herdr-api-agent-start)
                       (lambda (&rest _)
                         `((agent . ,(herdr-agent-tests--agent
                                      "claude" terminal-id "work:pane" "work")))))
                      ((symbol-function 'set-process-sentinel)
                       (lambda (process sentinel)
                         (funcall original-set-process-sentinel process sentinel)
                         (unless (memq process installed)
                           (push process installed)
                           (unless (equal terminal-id "term-adapter-death")
                             (push (herdr-agent-find server-key terminal-id) published)
                             (delete-process process))))))
              (dolist (flow '(adopt start-in-pane))
                (setq terminal-id (format "term-%s-death" flow))
                (should-error
                 (if (eq flow 'adopt)
                     (herdr-agent-adopt
                      (herdr-agent-tests--agent "claude" terminal-id "work:pane" "work")
                      :server-key server-key)
                   (herdr-agent-start-in-pane
                    "claude" "review"
                    (herdr-agent-tests--pane "claude" terminal-id "work:pane" "work")
                    :server-key server-key :args '()))
                 :type 'herdr-error)
                (should-not (herdr-agent-find server-key terminal-id)))
              (setq terminal-id "term-adapter-death"
                    adapter-error
                    (condition-case error
                        (progn
                          (herdr-agent-adopt
                           (herdr-agent-tests--agent
                            "claude" terminal-id "work:pane" "work")
                           :server-key server-key)
                          'returned)
                      (error error))
                    adapter-session (herdr-agent-find server-key terminal-id)))
            (should (equal (nreverse published) '(nil nil)))
            (should (eq (car-safe adapter-error) 'herdr-error))
            (should-not adapter-session))
          (setq requests nil)
          (setq retry-session
                (herdr-agent-adopt
                 (herdr-agent-tests--agent "pi" "term-retry" "retry:pane" "work")
                 :server-key server-key))
          (with-current-buffer (herdr-agent-session-buffer retry-session)
            (add-hook 'kill-buffer-hook #'herdr-agent-tests--fail-cleanup nil t))
          (herdr-agent-detach retry-session)
          (should (eq (herdr-agent-session-state retry-session) 'detaching))
          (should (eq (herdr-agent-find server-key "term-retry") retry-session))
          (should-not requests)
          (with-current-buffer (herdr-agent-session-buffer retry-session)
            (remove-hook 'kill-buffer-hook #'herdr-agent-tests--fail-cleanup t))
          (herdr-agent-detach retry-session)
          (should (eq (herdr-agent-session-state retry-session) 'stopped))
          (should-not (herdr-agent-find server-key "term-retry"))
          (should-not requests))
      (dolist (process subscription-processes)
        (when (process-live-p process)
          (delete-process process)))
      (remhash (herdr-agent--canonical-server-key server-key)
               herdr-agent--subscriptions)
      (herdr-agent-tests--detach dead-session)
      (herdr-agent-tests--detach retry-session)
      (mapc #'herdr-agent-tests--dispose-attachment attachments)
      (delete-directory root t))))

(ert-deftest herdr-agent-start-rollback-cleans-only-transaction-owned-resources ()
  (let ((herdr-agent-harnesses
         (herdr-agent-tests--with-adapter "claude" nil))
        (root (make-temp-file "herdr-agent-rollback" t)))
    (unwind-protect
        (progn
          (let* ((server-key (expand-file-name "subscription-batch-death/herdr.sock" root))
                 (subscription-calls 0)
                 (first-attempt nil)
                 (candidates nil)
                 first-error first-call-count first-attempt-liveness
                 first-cache-publication clean-retry-cache-length clean-retry-cache-liveness)
            (unwind-protect
                (cl-letf (((symbol-function 'herdr-subscribe)
                           (lambda (&rest _)
                             (cl-incf subscription-calls)
                             (let ((process
                                    (start-process "herdr-agent-subscription" nil
                                                   "sleep" "30")))
                               (push process candidates)
                               (when (<= subscription-calls 5)
                                 (push process first-attempt))
                               (when (= subscription-calls 5)
                                 (delete-process (car (last first-attempt))))
                               process))))
                  (setq first-error
                        (condition-case error-data
                            (progn (herdr-agent-subscribe server-key) nil)
                          (herdr-error error-data))
                        first-call-count subscription-calls
                        first-attempt-liveness
                        (mapcar #'process-live-p first-attempt)
                        first-cache-publication
                        (gethash (herdr-agent--canonical-server-key server-key)
                                 herdr-agent--subscriptions))
                  (herdr-agent-subscribe server-key)
                  (let ((cached (gethash (herdr-agent--canonical-server-key server-key)
                                         herdr-agent--subscriptions)))
                    (setq clean-retry-cache-length (length cached)
                          clean-retry-cache-liveness
                          (mapcar #'process-live-p cached))))
              (dolist (process candidates)
                (when (process-live-p process)
                  (delete-process process)))
              (remhash (herdr-agent--canonical-server-key server-key)
                       herdr-agent--subscriptions))
            (should (equal (car-safe first-error) 'herdr-error))
            (should (equal (cadr first-error)
                           "subscription batch contains a dead process"))
            (should (= first-call-count 5))
            (should (cl-every #'null first-attempt-liveness))
            (should-not first-cache-publication)
            (should (= clean-retry-cache-length 5))
            (should (cl-every #'identity clean-retry-cache-liveness)))
          (let ((server-key (expand-file-name "subscription/herdr.sock" root))
                (agent-starts 0)
                (attachments 0)
                (preparations 0)
                (topologies 0)
                (subscription-message "no herdr socket during startup"))
            (cl-letf (((symbol-function 'herdr-start-server-if-needed)
                       (lambda (&rest _) t))
                      ((symbol-function 'herdr-subscribe)
                       (lambda (&rest _)
                         (signal 'herdr-error (list subscription-message))))
                      ((symbol-function 'herdr-workspace-id)
                       (lambda (&rest _) "work"))
                      ((symbol-function 'herdr-api-agent-list)
                       (lambda () '((agents . ()))))
                      ((symbol-function 'herdr-agent--run-adapter)
                       (lambda (&rest arguments)
                         (when (memq :prepare arguments)
                           (cl-incf preparations)
                           (ert-fail "adapter preparation followed subscription failure"))))
                      ((symbol-function 'herdr-open-tab)
                       (lambda (&rest _)
                         (cl-incf topologies)
                         `((workspace . ((workspace_id . "work")))
                           (tab . ((tab_id . "work:tab")
                                   (workspace_id . "work")))
                           (root_pane . ((pane_id . "work:pane")
                                         (tab_id . "work:tab")
                                         (workspace_id . "work"))))))
                      ((symbol-function 'herdr-api-agent-start)
                       (lambda (&rest _)
                         (cl-incf agent-starts)
                         (ert-fail "agent startup followed subscription failure")))
                      ((symbol-function 'herdr-attach-terminal)
                       (lambda (&rest _)
                         (cl-incf attachments)
                         (ert-fail "attachment followed subscription failure"))))
              (let ((error
                     (should-error
                      (herdr-agent-start-session "pi" "review"
                                                 :server-key server-key :project-root root)
                      :type 'herdr-error)))
                (should (equal (cadr error) subscription-message)))
              (should-not (herdr-agent-find server-key nil))
              (should (= agent-starts 0))
              (should (= attachments 0))
              (should (= preparations 0))
              (should (= topologies 0))
              (setq subscription-message "subscription failed")
              (let ((error
                     (should-error
                      (herdr-agent-adopt
                       (herdr-agent-tests--agent
                        "pi" "term-subscription" "work:pane" "work")
                       :server-key server-key))))
                (should (equal (cadr error) subscription-message)))
              (should-not (herdr-agent-find server-key "term-subscription"))))
          (let* ((server-key (expand-file-name "subscription-transaction/herdr.sock" root))
                 (subscription-calls 0)
                 (candidates nil)
                 (first-attempt nil))
            (unwind-protect
                (cl-letf (((symbol-function 'herdr-subscribe)
                           (lambda (&rest _)
                             (cl-incf subscription-calls)
                             (if (= subscription-calls 3)
                                 (signal 'herdr-error '("third subscription failed"))
                               (let ((process
                                      (start-process "herdr-agent-subscription" nil
                                                     "sleep" "30")))
                                 (push process candidates)
                                 (when (< subscription-calls 3)
                                   (push process first-attempt))
                                 process)))))
                  (should-error (herdr-agent-subscribe server-key) :type 'herdr-error)
                  (should (cl-every (lambda (process) (not (process-live-p process)))
                                    first-attempt))
                  (should-not (gethash (herdr-agent--canonical-server-key server-key)
                                       herdr-agent--subscriptions))
                  (herdr-agent-subscribe server-key)
                  (let ((cached (gethash (herdr-agent--canonical-server-key server-key)
                                         herdr-agent--subscriptions)))
                    (should (= (length cached) 5))
                    (should (cl-every #'process-live-p cached))
                    (should-not (cl-intersection cached first-attempt :test #'eq))))
              (dolist (process candidates)
                (when (process-live-p process)
                  (delete-process process)))
              (remhash (herdr-agent--canonical-server-key server-key)
                       herdr-agent--subscriptions)))
          (let* ((server-key (expand-file-name "subscription-nil/herdr.sock" root))
                 (subscription-calls 0)
                 (candidates nil)
                 (operations nil))
            (unwind-protect
                (cl-letf (((symbol-function 'herdr-start-server-if-needed)
                           (lambda (&rest _) t))
                          ((symbol-function 'herdr-subscribe)
                           (lambda (&rest _)
                             (cl-incf subscription-calls)
                             (if (= subscription-calls 3)
                                 nil
                               (let ((process
                                      (start-process "herdr-agent-subscription" nil
                                                     "sleep" "30")))
                                 (push process candidates)
                                 process))))
                          ((symbol-function 'herdr-workspace-id)
                           (lambda (&rest _) "work"))
                          ((symbol-function 'herdr-api-agent-list)
                           (lambda () '((agents . ()))))
                          ((symbol-function 'herdr-agent--run-adapter)
                           (lambda (&rest arguments)
                             (when (memq :prepare arguments)
                               (push 'prepare operations))))
                          ((symbol-function 'herdr-open-tab)
                           (lambda (&rest _)
                             (push 'topology operations)))
                          ((symbol-function 'herdr-api-agent-start)
                           (lambda (&rest _)
                             (push 'agent-start operations))))
                  (should-error
                   (herdr-agent-start-session "pi" "nil-subscription"
                                              :server-key server-key :project-root root)
                   :type 'herdr-error)
                  (should (= subscription-calls 3))
                  (should (cl-every (lambda (process) (not (process-live-p process)))
                                    candidates))
                  (should-not (memq 'prepare operations))
                  (should-not (memq 'topology operations))
                  (should-not (memq 'agent-start operations))
                  (should-not (gethash (herdr-agent--canonical-server-key server-key)
                                       herdr-agent--subscriptions)))
              (dolist (process candidates)
                (when (process-live-p process)
                  (delete-process process)))
              (remhash (herdr-agent--canonical-server-key server-key)
                       herdr-agent--subscriptions)))
          (let ((server-key (expand-file-name "subscription-unreachable/herdr.sock" root))
                (starts 0))
            (unwind-protect
                (cl-letf (((symbol-function 'herdr-subscribe)
                           (lambda (&rest _)
                             (signal 'herdr-error '("cannot reach herdr during startup"))))
                          ((symbol-function 'herdr-api-agent-start)
                           (lambda (&rest _)
                             (cl-incf starts))))
                  (let ((error
                         (should-error
                          (herdr-agent-start-in-pane
                           "pi" "unreachable"
                           (herdr-agent-tests--pane "pi" "pending" "work:pane" "work")
                           :server-key server-key :args '())
                          :type 'herdr-error)))
                    (should (equal (cadr error) "cannot reach herdr during startup")))
                  (should (= starts 0))
