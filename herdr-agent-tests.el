(ert-deftest herdr-agent-start-preflights-names-on-the-resolved-project-server ()
  (herdr-agent-tests--require-functions
   'herdr-agent-start 'herdr-agent-continue 'herdr-agent-resume)
  (let* ((root (make-temp-file "herdr-agent-preflight" t))
         (assigned-server (expand-file-name "assigned/herdr.sock" (file-truename root)))
         (default-server (expand-file-name "default/herdr.sock" (file-truename root)))
         (trace nil)
         (starts nil)
         (lifecycle-calls nil)
         (failures nil)
         (occupancy-fault nil)
         (subscription-processes nil)
         invalid-result invalid-trace occupancy-result occupancy-trace
         occupancy-starts sessions)
    (unwind-protect
        (cl-letf (((symbol-function 'herdr-project-root)
                   (lambda (&optional _directory)
                     (push 'project-root trace)
                     root))
                  ((symbol-function 'herdr-session-for)
                   (lambda (project-root)
                     (should (equal project-root root))
                     (push 'session-for trace)
                     "assigned"))
                  ((symbol-function 'herdr-server-key)
                   (lambda ()
                     (push (list 'server-key herdr-session) trace)
                     (if (equal herdr-session "assigned")
                         assigned-server
                       default-server)))
                  ((symbol-function 'herdr-start-server-if-needed)
                   (lambda (&rest _)
                     (push (list 'server-start herdr-session) trace)))
                  ((symbol-function 'herdr-subscribe)
                   (lambda (&rest _)
                     (let ((process
                            (start-process "herdr-agent-subscription" nil "sleep" "30")))
                       (push process subscription-processes)
                       process)))
                  ((symbol-function 'herdr-workspace-id)
                   (lambda (&rest _)
                     (push (list 'workspace herdr-session) trace)
                     "work"))
                  ((symbol-function 'herdr-api-agent-list)
                   (lambda ()
                     (push (list 'agent-list herdr-session) trace)
                     (if occupancy-fault
                         (signal 'herdr-api-error '("occupancy query failed"))
                       '((agents . (((name . "review"))))))))
                  ((symbol-function 'herdr-api-tab-create)
                   (lambda (&rest _)
                     (push (list 'topology herdr-session) trace)
                     '((tab . ((tab_id . "work:tab") (workspace_id . "work")))
                       (root_pane . ((pane_id . "work:pane")
                                     (tab_id . "work:tab")
                                     (workspace_id . "work"))))))
                  ((symbol-function 'herdr-api-agent-start)
                   (lambda (kind name pane-id &rest _)
                     (let ((start (list kind name pane-id herdr-session)))
                       (if occupancy-fault
                           (push start occupancy-starts)
                         (push start starts)))
                     `((agent . ,(herdr-agent-tests--agent
                                  kind (concat name ":terminal") pane-id "work"))))))
          (let ((herdr-session 'shared)
                (default-directory root))
            (dolist (name '(nil "" "review"))
              (let ((result
                     (condition-case error-data
                         (herdr-agent-start "pi" name :attach nil)
                       (error error-data))))
                (if (herdr-agent-session-p result)
                    (push result sessions)
                  (push result failures))))
            (let ((valid-trace trace))
              (setq trace nil
                    invalid-result
                    (condition-case error-data
                        (herdr-agent-start "pi" "Invalid" :attach nil)
                      (error error-data))
                    invalid-trace trace
                    trace valid-trace)
              (when (herdr-agent-session-p invalid-result)
                (push invalid-result sessions)))
            (setq trace nil
                  occupancy-fault t
                  occupancy-result
                  (condition-case error-data
                      (herdr-agent-start "pi" "occupancy-fault" :attach nil)
                    (error error-data))
                  occupancy-trace trace
                  occupancy-fault nil)
            (cl-letf (((symbol-function 'herdr-agent-start-session)
                       (lambda (&rest arguments)
                         (push arguments lifecycle-calls))))
              (herdr-agent-continue "pi" "review"
                                    :server-key assigned-server :project-root root)
              (herdr-agent-resume "pi" "review" "pi-session"
                                  :server-key assigned-server :project-root root)))
          (setq starts (nreverse starts)
                lifecycle-calls (nreverse lifecycle-calls)
                trace (nreverse trace))
          (should-not failures)
          (should (= (length starts) 3))
          (should (cl-every (lambda (start)
                              (and (equal (car start) "pi")
                                   (string-match-p
                                    "\\`[a-z][a-z0-9_-]\\{0,31\\}\\'"
                                    (nth 1 start))
                                   (not (equal (nth 1 start) "review"))
                                   (equal (nth 3 start) "assigned")))
                            starts))
          (should-not (equal (nth 1 (car starts)) (nth 1 (cadr starts))))
          (should-not (equal (nth 1 (cadr starts)) (nth 1 (caddr starts))))
          (should (= (length lifecycle-calls) 2))
          (dolist (expected-args '(("--continue") ("--session" "pi-session")))
            (let ((arguments (pop lifecycle-calls)))
              (should (equal (car arguments) "pi"))
              (should (equal (cadr arguments) "review"))
              (let ((properties (cddr arguments)))
                (should (equal (plist-get properties :server-key) assigned-server))
                (should (equal (plist-get properties :project-root) root))
                (should (equal (plist-get properties :args) expected-args)))))
          (should
           (cl-every (lambda (entry)
                       (or (memq entry '(project-root session-for))
                           (and (consp entry) (equal (cadr entry) "assigned"))))
                     trace))
          (let ((project-position (cl-position 'project-root trace))
                (session-position (cl-position 'session-for trace))
                (server-position (cl-position '(server-key "assigned") trace
                                             :test #'equal)))
            (should (and project-position session-position server-position
                         (< project-position session-position server-position))))
          (should (and (consp invalid-result)
                       (eq (car invalid-result) 'user-error)))
          (should-not
           (cl-find-if (lambda (entry)
                         (and (consp entry)
                              (memq (car entry)
                                    '(topology server-start workspace agent-list))))
                       invalid-trace))
          (should (and (consp occupancy-result)
                       (eq (car occupancy-result) 'herdr-api-error)
                       (equal (cadr occupancy-result) "occupancy query failed")))
          (should (member '(agent-list "assigned") occupancy-trace))
          (should-not
           (cl-find-if (lambda (entry)
                         (and (consp entry)
                              (memq (car entry) '(topology workspace))))
                       occupancy-trace))
          (should-not occupancy-starts))
      (mapc #'herdr-agent-tests--detach sessions)
      (dolist (process subscription-processes)
        (when (process-live-p process)
          (delete-process process)))
      (remhash (herdr-agent--canonical-server-key assigned-server)
               herdr-agent--subscriptions)
      (remhash (herdr-agent--canonical-server-key default-server)
               herdr-agent--subscriptions)
      (delete-directory root t))))

