                  (,server-a get "shared")
                  (,server-a get "shared")
                  (,server-a close "a:pane")
                  (,server-a prompt "shared" "Write the tests" nil)
                  (,server-a keys ("esc") "shared")
                  (,server-a keys ("enter") "shared")
                  (,server-a list)
                  (,server-a close "a:pane")))))))
      (herdr-agent-tests--detach session-a)
      (herdr-agent-tests--detach session-b)
