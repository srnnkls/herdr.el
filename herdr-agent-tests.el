(defun herdr-agent-tests--message-fixture ()
  "Return three agent entries: worktree, main, and other."
  (list '((server_key . "/servers/worktree.sock")
          (terminal_id . "shared") (name . "worktree")
          (agent . "claude") (cwd . "/repo/.worktrees/fix/"))
        '((server_key . "/servers/main.sock")
          (terminal_id . "shared") (name . "main")
          (agent . "pi") (cwd . "/repo/"))
        '((server_key . "/servers/other.sock")
          (terminal_id . "other") (name . "other")
          (agent . "codex") (cwd . "/other/"))))

(defmacro herdr-agent-tests--with-message-fixture (&rest body)
  "Run BODY with stubbed sessions, project roots, and workspace labels."
  (declare (indent 0) (debug t))
  `(let* ((entries (herdr-agent-tests--message-fixture))
          (herdr-project-root-function
           (lambda (directory)
             (cond
              ((string-prefix-p "/repo/.worktrees/fix/" directory)
               "/repo/.worktrees/fix/")
              ((string-prefix-p "/repo/" directory) "/repo/")
              ((string-prefix-p "/other/" directory) "/other/"))))
          (herdr-workspace-label-function
           (lambda (directory)
             (if (string-prefix-p "/repo/" directory) "repo" "other")))
          (herdr-current-workspace-label-function (lambda () "repo"))
          (herdr-send-context-functions
           (list (lambda (entry) (format "context:%s" (alist-get 'name entry)))))
          (herdr-message-history nil)
          (herdr--recent-session-targets nil)
          (herdr--project-agents nil)
          (herdr--workspace-agents nil)
          (buffer-file-name "/repo/.worktrees/fix/source.el")
          (default-directory "/repo/.worktrees/fix/")
          agent-reads message-reads prompts)
     (cl-letf (((symbol-function 'herdr-sessions) (lambda () entries))
               ((symbol-function 'herdr-agent-prompt)
                (lambda (target text) (push (list target text) prompts)))
               ((symbol-function 'completing-read)
                (lambda (prompt collection &rest _)
                  (if (string-prefix-p "Message: " prompt)
                      (progn (push collection message-reads) "do it")
                    (push prompt agent-reads)
                    "worktree"))))
       ,@body)))

(ert-deftest herdr-message-last-project-session-uses-the-mru-without-choosing ()
  (herdr-agent-tests--with-message-fixture
    (setq herdr--recent-session-targets
          '(("/servers/other.sock" . "other")
            ("/servers/worktree.sock" . "shared")))
    (herdr-message-last-project-session)
    (should-not agent-reads)
    (should (equal prompts
                   '((("/servers/worktree.sock" . "shared")
                      "do it\n\n---\ncontext:worktree"))))
    (should (equal herdr-message-history '("do it")))
    (herdr-message-project-session)
    (should (equal agent-reads '("Message agent: ")))
    (should (equal (car message-reads) '("do it")))))

(ert-deftest herdr-message-editor-sends-captured-context-or-cancels ()
  (let ((herdr-message-history nil)
        (target '("/servers/a.sock" . "shared"))
        prompts)
    (cl-letf (((symbol-function 'herdr-agent-prompt)
               (lambda (target text) (push (list target text) prompts)))
              ((symbol-function 'herdr-sessions) (lambda () nil)))
      (save-window-excursion
        (let ((buffer (herdr-message--edit target "draft" "Emacs context:\n\nx.el:3\n\nline")))
          (should (eq (current-buffer) buffer))
          (should (derived-mode-p 'herdr-message-mode))
          (should (string-match-p "\\[x.el:3\\]" header-line-format))
          (goto-char (point-max))
          (insert " and more")
          (herdr-message-send)
          (should-not (buffer-live-p buffer)))
        (let ((buffer (herdr-message--edit target "never" nil)))
          (herdr-message-cancel)
          (should-not (buffer-live-p buffer)))))
    (should (equal prompts
                   `((,target "draft and more\n\n---\nEmacs context:\n\nx.el:3\n\nline"))))
    (should (equal herdr-message-history '("draft and more")))))

(ert-deftest herdr-message-pop-out-throws-an-editor-continuation ()
  (let ((herdr-message--pending (cons '("/servers/a.sock" . "shared") "ctx")))
    (cl-letf (((symbol-function 'minibuffer-contents) (lambda () "half"))
              ((symbol-function 'herdr-sessions) (lambda () nil)))
      (let ((continuation (catch 'exit (herdr-message-edit-from-minibuffer))))
        (should (functionp continuation))
        (save-window-excursion
          (let ((buffer (funcall continuation)))
            (unwind-protect
                (with-current-buffer buffer
                  (should (equal (buffer-string) "half"))
                  (should (equal herdr-message--target '("/servers/a.sock" . "shared")))
                  (should (equal herdr-message--context "ctx")))
              (kill-buffer buffer))))))))

(ert-deftest herdr-primary-agent-resolves-buffer-then-project-then-workspace ()
  (herdr-agent-tests--with-message-fixture
    (let ((worktree '("/servers/worktree.sock" . "shared"))
          (main '("/servers/main.sock" . "shared"))
          (other '("/servers/other.sock" . "other"))
          (gone '("/servers/gone.sock" . "gone")))
      (with-temp-buffer
        (setq buffer-file-name "/repo/.worktrees/fix/source.el")
        (should-not (herdr-primary-agent-target))
        (setq herdr--workspace-agents (list (cons "repo" other)))
        (should (equal (herdr-primary-agent-target) other))
        (setq herdr--project-agents (list (cons "/repo/.worktrees/fix/" main)))
        (should (equal (herdr-primary-agent-target) main))
        (setq herdr-current-agent worktree)
        (should (equal (herdr-primary-agent-target) worktree))
        (setq herdr-current-agent gone
              herdr--project-agents (list (cons "/repo/.worktrees/fix/" gone)))
        (should (equal (herdr-primary-agent-target) other))
        (should-not herdr-current-agent)
        (should-not herdr--project-agents)))))

(ert-deftest herdr-message-primary-session-binds-the-project-on-first-use ()
  (herdr-agent-tests--with-message-fixture
    (with-temp-buffer
      (setq buffer-file-name "/repo/.worktrees/fix/source.el")
      (herdr-message-primary-session)
      (should (equal agent-reads '("Primary agent: ")))
      (should (equal herdr--project-agents
                     '(("/repo/.worktrees/fix/" . ("/servers/worktree.sock" . "shared")))))
      (herdr-message-primary-session)
      (should (= (length agent-reads) 1))
      (should (equal prompts
                     '((("/servers/worktree.sock" . "shared") "do it\n\n---\ncontext:worktree")
                       (("/servers/worktree.sock" . "shared") "do it\n\n---\ncontext:worktree"))))
      (herdr-send-primary-session)
      (should (equal (car prompts)
                     '(("/servers/worktree.sock" . "shared") "context:worktree"))))))

(ert-deftest herdr-associate-and-dissociate-agent-cover-all-scopes ()
  (herdr-agent-tests--with-message-fixture
    (with-temp-buffer
      (setq buffer-file-name "/repo/.worktrees/fix/source.el")
      (let ((worktree '("/servers/worktree.sock" . "shared")))
        (call-interactively #'herdr-associate-agent)
        (should (equal herdr-current-agent worktree))
        (call-interactively #'herdr-associate-project-agent)
        (should (equal herdr--project-agents
                       (list (cons "/repo/.worktrees/fix/" worktree))))
        (call-interactively #'herdr-associate-workspace-agent)
        (should (equal herdr--workspace-agents (list (cons "repo" worktree))))
        (herdr-dissociate-agent)
        (should-not herdr-current-agent)
        (should herdr--project-agents)
        (herdr-dissociate-agent t)
        (should-not herdr--project-agents)
        (should-not herdr--workspace-agents)
        (let ((herdr-current-workspace-label-function (lambda () nil))
              (default-directory "/elsewhere/"))
          (setq buffer-file-name nil)
          (should-error (call-interactively #'herdr-associate-project-agent)
                        :type 'user-error)
          (should-error (call-interactively #'herdr-associate-workspace-agent)
                        :type 'user-error))))))

