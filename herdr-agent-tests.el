(ert-deftest herdr-agent-native-start-continue-and-resume-use-harness-arguments ()
  (herdr-agent-tests--require-functions
   'herdr-agent-start 'herdr-agent-continue 'herdr-agent-resume)
  (let* ((root (make-temp-file "herdr-agent-native-launch" t))
         (server-key (expand-file-name "herdr.sock" root))
         (attachments nil)
         (starts nil)
         (tab-creations nil)
         (prepared-projects nil)
         (subscription-processes nil)
         sessions)
    (unwind-protect
        (cl-letf (((symbol-function 'herdr-start-server-if-needed)
                   (lambda (&rest _) t))
                  ((symbol-function 'herdr-subscribe)
                   (lambda (&rest _)
                     (let ((process
                            (start-process "herdr-agent-subscription" nil "sleep" "30")))
                       (push process subscription-processes)
                       process)))
                  ((symbol-function 'herdr-workspace-id)
                   (lambda (&rest _) "work"))
                  ((symbol-function 'herdr-api-agent-list)
                   (lambda () '((agents . ()))))
                  ((symbol-function 'herdr-api-tab-create)
                   (lambda (&rest arguments)
                     (push arguments tab-creations)
                     '((tab . ((tab_id . "work:tab") (workspace_id . "work")))
                       (root_pane . ((pane_id . "work:tab:root")
                                     (tab_id . "work:tab")
                                     (workspace_id . "work"))))))
                  ((symbol-function 'herdr-agent--run-adapter)
                   (lambda (session phase &optional context)
                     (pcase phase
                       (:prepare
                        (push (herdr-agent-session-project session)
                              prepared-projects)
                        nil)
                       (:arguments (cons "--adapter" context)))))
                  ((symbol-function 'herdr-api-agent-start)
                   (lambda (kind name pane-id &rest arguments)
                     (push (list kind name pane-id arguments) starts)
                     `((agent . ,(herdr-agent-tests--agent
                                  kind (concat pane-id ":terminal") pane-id "work")))))
                  ((symbol-function 'herdr-attach-terminal)
                   (lambda (terminal-id &rest _)
                     (let ((attachment
                            (herdr-agent-tests--attachment terminal-id terminal-id)))
                       (push attachment attachments)
                       (car attachment)))))
          (dolist (harness (herdr-agent-tests--harnesses))
            (let* ((kind (alist-get 'kind harness))
                   (reference (format "%s-session" kind)))
              (push (herdr-agent-start kind "review"
                                       :server-key server-key :project-root root)
                    sessions)
              (push (herdr-agent-continue kind "review"
                                          :server-key server-key :project-root root)
                    sessions)
              (push (herdr-agent-resume kind "review" reference
                                        :server-key server-key :project-root root)
                    sessions)
              (setq starts (nreverse starts))
              (should (equal (mapcar (lambda (call)
                                       (list (car call) (nth 3 call)))
                                     starts)
                             (mapcar
                              (lambda (action)
                                (list kind
                                      (list :args
                                            (cons
                                             "--adapter"
                                             (herdr-agent-tests--harness-arguments
                                              harness action reference)))))
                              '(start continue resume))))
              (setq starts nil)
              (should-error
               (herdr-agent-resume kind "review" nil
                                   :server-key server-key :project-root root)
               :type 'user-error)
              (should-not starts)))
          (let ((implicit-root (file-name-as-directory
                                (expand-file-name "implicit" root))))
            (make-directory implicit-root)
            (let ((default-directory implicit-root))
              (push (herdr-agent-start "pi" "implicit-root" :server-key server-key)
                    sessions))
            (should
             (member (directory-file-name (file-truename implicit-root))
                     (mapcar (lambda (arguments)
                               (directory-file-name
                                (file-truename (plist-get arguments :cwd))))
                             tab-creations)))
            (should (member (directory-file-name (file-truename implicit-root))
                            prepared-projects))))
      (mapc #'herdr-agent-tests--detach sessions)
      (mapc #'herdr-agent-tests--dispose-attachment attachments)
      (dolist (process subscription-processes)
        (when (process-live-p process)
          (delete-process process)))
      (remhash (herdr-agent--canonical-server-key server-key)
               herdr-agent--subscriptions)
      (delete-directory root t))))

(ert-deftest herdr-agent-native-target-resolution-is-explicit-project-local-and-mru ()
  (herdr-agent-tests--require-functions 'herdr-agent-resolve-target)
  (let* ((project "/projects/alpha/")
         (agents '(((terminal_id . "foreign") (agent . "aider")
                   (cwd . "/projects/beta/"))
                  ((terminal_id . "alpha-old") (agent . "pi")
                   (cwd . "/projects/alpha/"))
