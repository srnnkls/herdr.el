(ert-deftest herdr-send-scopes-complete-or-use-the-filtered-mru ()
  (let* ((worktree '((server_key . "/servers/worktree.sock")
                     (terminal_id . "shared") (name . "worktree")
                     (agent . "claude") (cwd . "/repo/.worktrees/fix/")))
         (main '((server_key . "/servers/main.sock")
                 (terminal_id . "shared") (name . "main")
                 (agent . "pi") (cwd . "/repo/")))
         (other '((server_key . "/servers/other.sock")
                  (terminal_id . "other") (name . "other")
                  (agent . "codex") (cwd . "/other/")))
         (pane '((server_key . "/servers/main.sock")
                 (terminal_id . "pane") (cwd . "/repo/")))
         (herdr-project-root-function
          (lambda (directory)
            (cond
             ((string-prefix-p "/repo/.worktrees/fix/" directory)
              "/repo/.worktrees/fix/")
             ((string-prefix-p "/repo/" directory) "/repo/")
             ((string-prefix-p "/other/" directory) "/other/"))))
         (herdr-workspace-label-function
          (lambda (directory)
            (if (string-prefix-p "/repo/" directory) "repo" "other")))
         (herdr-current-workspace-label-function (lambda () "repo"))
         (herdr--recent-session-targets
          '(("/servers/stale.sock" . "stale")
            ("/servers/main.sock" . "shared")
            ("/servers/worktree.sock" . "shared")))
         (herdr-send-context-functions
          (list (lambda (entry) (format "context:%s" (alist-get 'name entry)))))
         (buffer-file-name "/repo/.worktrees/fix/source.el")
         completions prompts)
    (cl-letf (((symbol-function 'herdr-sessions)
               (lambda () (list worktree main other pane)))
              ((symbol-function 'completing-read)
               (lambda (_prompt _collection &rest _)
                 (push t completions)
                 "worktree"))
              ((symbol-function 'herdr-agent-prompt)
               (lambda (target text) (push (list target text) prompts))))
      (herdr-send-project-session)
      (herdr-send-last-workspace-session))
    (should (= (length completions) 1))
    (should (equal (nreverse prompts)
                   '((("/servers/worktree.sock" . "shared") "context:worktree")
                     (("/servers/main.sock" . "shared") "context:main"))))
    (should (equal herdr--recent-session-targets
                   '(("/servers/main.sock" . "shared")
                     ("/servers/worktree.sock" . "shared"))))))

(ert-deftest herdr-agent-prompt-records-only-successful-targets ()
  (let ((herdr--recent-session-targets nil)
        calls)
    (cl-letf (((symbol-function 'herdr-agent--call-with-request-target)
               (lambda (_server-key terminal function)
                 (if (equal terminal "failed")
                     (error "prompt failed")
                   (funcall function terminal))))
              ((symbol-function 'herdr-api-agent-prompt)
               (lambda (target text) (push (list target text) calls))))
      (herdr-agent-prompt '("/tmp/herdr.sock" . "ok") "hello")
      (should-error
       (herdr-agent-prompt '("/tmp/herdr.sock" . "failed") "ignored")))
    (should (equal calls '(("ok" "hello"))))
    (should (equal herdr--recent-session-targets
                   (list (cons (herdr-agent--canonical-server-key
                                "/tmp/herdr.sock")
                               "ok"))))))

(ert-deftest herdr-send-context-providers-receive-the-selected-entry ()
