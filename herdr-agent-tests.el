(ert-deftest herdr-agent-native-switch-focuses-the-visible-owned-terminal ()
  (herdr-agent-tests--require-functions 'herdr-agent-switch)
  (let ((buffer (get-buffer-create " *herdr-agent-native-visible*"))
        (focused nil)
        (attached nil)
        (created-tab nil)
        (herdr-use-side-window t)
        (herdr-window-side 'right)
        (herdr-window-width 20)
        (herdr-display-buffer-action nil))
    (unwind-protect
        (cl-letf (((symbol-function 'herdr-api-agent-focus)
                   (lambda (target) (setq focused target)))
                  ((symbol-function 'herdr-terminal-buffer)
                   (lambda (terminal-id &optional _server-key)
                     (and (equal terminal-id "term-a") buffer)))
                  ((symbol-function 'herdr-attach-terminal)
                   (lambda (&rest _) (setq attached t)))
                  ((symbol-function 'herdr-api-tab-create)
                   (lambda (&rest _) (setq created-tab t))))
          (let ((window (herdr-agent-switch "term-a")))
            (should (equal focused "term-a"))
            (should (windowp window))
            (should (eq (window-buffer window) buffer))
            (should (eq (selected-window) window))
            (should (eq (window-parameter window 'window-side) 'right))
            (should (window-live-p (get-buffer-window buffer t)))
            (should-not attached)
            (should-not created-tab)))
      (when (buffer-live-p buffer)
        (kill-buffer buffer)))))

(ert-deftest herdr-agent-native-composite-target-routes-every-action-to-owning-server ()
  (herdr-agent-tests--require-functions
   'herdr-agent-list 'herdr-agent-switch 'herdr-agent-rename
   'herdr-agent-status 'herdr-agent-stop 'herdr-agent-stop-all
   'herdr-agent-prompt 'herdr-agent-escape 'herdr-agent-newline)
  (let* ((root (make-temp-file "herdr-agent-composite" t))
         (socket-a (expand-file-name "a/herdr.sock" root))
         (socket-b (expand-file-name "b/herdr.sock" root))
         (attachments nil)
         (calls nil)
         session-a session-b server-a server-b)
    (unwind-protect
        (progn
          (make-directory (file-name-directory socket-a) t)
          (make-directory (file-name-directory socket-b) t)
          (let ((herdr-socket-path socket-a))
            (setq server-a (herdr-server-key)))
          (let ((herdr-socket-path socket-b))
            (setq server-b (herdr-server-key)))
          (cl-letf (((symbol-function 'herdr-attach-terminal)
                     (lambda (terminal-id &rest _)
                       (let ((attachment
                              (herdr-agent-tests--attachment terminal-id terminal-id)))
                         (push attachment attachments)
                         (car attachment)))))
            (setq session-a
                  (herdr-agent-adopt
                   (herdr-agent-tests--agent "claude" "shared" "a:pane" "a")
                   :server-key server-a)
                  session-b
                  (herdr-agent-adopt
                   (herdr-agent-tests--agent "pi" "shared" "b:pane" "b")
                   :server-key server-b)))
          (let ((target (cons server-a "shared"))
                (agent-a (herdr-agent-tests--agent "claude" "shared" "a:pane" "a"))
                (herdr-socket-path server-b))
            (cl-letf (((symbol-function 'herdr-api-agent-list)
                       (lambda ()
                         (push (list herdr-socket-path 'list) calls)
                         `((agents . (,agent-a)))))
                      ((symbol-function 'herdr-api-agent-focus)
                       (lambda (terminal-id)
                         (push (list herdr-socket-path 'focus terminal-id) calls)))
                      ((symbol-function 'herdr-api-agent-rename)
                       (lambda (terminal-id &rest arguments)
                         (push (list herdr-socket-path 'rename terminal-id arguments) calls)))
                      ((symbol-function 'herdr-api-agent-get)
                       (lambda (terminal-id)
                         (push (list herdr-socket-path 'get terminal-id) calls)
                         `((agent . ,agent-a))))
                      ((symbol-function 'herdr-api-pane-close)
                       (lambda (pane-id)
                         (push (list herdr-socket-path 'close pane-id) calls)))
                      ((symbol-function 'herdr-api-agent-prompt)
                       (lambda (terminal-id text &rest arguments)
                         (push (list herdr-socket-path 'prompt terminal-id text arguments) calls)))
                      ((symbol-function 'herdr-api-agent-send-keys)
                       (lambda (keys terminal-id)
                         (push (list herdr-socket-path 'keys keys terminal-id) calls)))
                      ((symbol-function 'herdr-terminal-buffer)
                       (lambda (terminal-id &optional server-key)
                         (push (list herdr-socket-path 'buffer terminal-id server-key) calls)
                         (herdr-agent-session-buffer session-a)))
                      ((symbol-function 'herdr--terminal-exec)
                       #'herdr-agent-tests--unexpected-cli)
                      ((symbol-function 'start-process)
                       #'herdr-agent-tests--unexpected-cli)
                      ((symbol-function 'process-file)
                       #'herdr-agent-tests--unexpected-cli)
                      ((symbol-function 'call-process)
                       #'herdr-agent-tests--unexpected-cli)
                      ((symbol-function 'shell-command)
                       #'herdr-agent-tests--unexpected-cli)
                      ((symbol-function 'call-process-shell-command)
                       #'herdr-agent-tests--unexpected-cli))
              (let ((herdr-socket-path server-a))
                (should (equal (herdr-agent-list) (list agent-a))))
              (herdr-agent-switch target)
              (herdr-agent-rename target "renamed")
              (let ((status (herdr-agent-status target)))
                (herdr-agent-stop target)
                (herdr-agent-prompt target "Write the tests")
                (herdr-agent-escape target)
                (herdr-agent-newline target)
                (let ((herdr-socket-path server-a))
                  (herdr-agent-stop-all))
                (should (equal status agent-a)))
              (should
               (equal
                (nreverse calls)
                `((,server-a list)
                  (,server-a focus "shared")
                  (,server-a buffer "shared" ,server-a)
                  (,server-a rename "shared" (:name "renamed"))
                  (,server-a get "shared")
                  (,server-a get "shared")
                  (,server-a close "a:pane")
                  (,server-a prompt "shared" "Write the tests" nil)
                  (,server-a keys ("esc") "shared")
                  (,server-a keys ("enter") "shared")
                  (,server-a list)
                  (,server-a close "a:pane")))))))
      (herdr-agent-tests--detach session-a)
      (herdr-agent-tests--detach session-b)
      (mapc #'herdr-agent-tests--dispose-attachment attachments)
      (delete-directory root t))))

(ert-deftest herdr-agent-native-public-target-ladder-keeps-composite-identity ()
  (herdr-agent-tests--require-functions
   'herdr-agent-adopt 'herdr-agent-prompt)
  (let* ((root (make-temp-file "herdr-agent-target-ladder" t))
         (project-a (expand-file-name "project-a" root))
         (project-b (expand-file-name "project-b" root))
         (socket-a (expand-file-name "a/herdr.sock" root))
         (socket-b (expand-file-name "b/herdr.sock" root))
         (socket-c (expand-file-name "c/herdr.sock" root))
         (attachments nil)
         (calls nil)
         session-a session-b server-a server-b server-c)
    (unwind-protect
        (progn
          (make-directory project-a t)
          (make-directory project-b t)
          (make-directory (file-name-directory socket-a) t)
          (make-directory (file-name-directory socket-b) t)
          (make-directory (file-name-directory socket-c) t)
          (let ((herdr-socket-path socket-a))
            (setq server-a (herdr-server-key)))
          (let ((herdr-socket-path socket-b))
            (setq server-b (herdr-server-key)))
          (let ((herdr-socket-path socket-c))
            (setq server-c (herdr-server-key)))
          (cl-letf (((symbol-function 'herdr-attach-terminal)
                     (lambda (terminal-id &rest _)
                       (let ((attachment
                              (herdr-agent-tests--attachment terminal-id terminal-id)))
                         (push attachment attachments)
                         (car attachment)))))
            (let ((default-directory project-a))
              (setq session-a
                    (herdr-agent-adopt
                     (herdr-agent-tests--agent "claude" "foreign" "a:pane" "a")
                     :server-key server-a)))
            (let ((default-directory project-b))
              (setq session-b
                    (herdr-agent-adopt
                     (herdr-agent-tests--agent "pi" "local" "b:pane" "b")
                     :server-key server-b))))
          (let ((herdr-socket-path server-c))
            (cl-letf (((symbol-function 'herdr-api-agent-prompt)
                       (lambda (terminal-id text &rest _)
                         (push (list herdr-socket-path terminal-id text) calls))))
              (with-current-buffer (herdr-agent-session-buffer session-a)
                (herdr-agent-prompt nil "attached"))
              (herdr-agent-prompt (cons server-b "local") "explicit")
              (let ((visible-source (generate-new-buffer " *herdr-agent-target-source*")))
                (unwind-protect
                    (save-window-excursion
                      (switch-to-buffer visible-source)
                      (with-current-buffer visible-source
                        (setq default-directory project-b))
                      (set-window-buffer (split-window-right)
                                         (herdr-agent-session-buffer session-a))
                      (herdr-agent-prompt nil "visible"))
                  (when (buffer-live-p visible-source)
                    (kill-buffer visible-source))))
              (with-temp-buffer
                (setq default-directory project-b)
                (herdr-agent-prompt nil "project-mru"))
              (should
               (equal (nreverse calls)
                      `((,server-a "foreign" "attached")
                        (,server-b "local" "explicit")
                        (,server-b "local" "visible")
                        (,server-b "local" "project-mru"))))))
      (herdr-agent-tests--detach session-a)
      (herdr-agent-tests--detach session-b)
      (mapc #'herdr-agent-tests--dispose-attachment attachments)
      (delete-directory root t)))))

(ert-deftest herdr-agent-native-resume-rejects-empty-reference-and-generic-kind ()
  (herdr-agent-tests--require-functions 'herdr-agent-start 'herdr-agent-resume)
  (let ((starts nil)
        (server-starts nil)
        (conditions nil))
    (cl-letf (((symbol-function 'herdr-start-server-if-needed)
               (lambda (&rest _)
                 (push t server-starts)))
              ((symbol-function 'herdr-api-agent-start)
               (lambda (&rest arguments)
                 (push arguments starts)
                 (error "agent.start must not be called")))
              ((symbol-function 'herdr--terminal-exec)
               #'herdr-agent-tests--unexpected-cli)
              ((symbol-function 'start-process)
               #'herdr-agent-tests--unexpected-cli)
              ((symbol-function 'process-file)
               #'herdr-agent-tests--unexpected-cli)
              ((symbol-function 'call-process)
               #'herdr-agent-tests--unexpected-cli)
              ((symbol-function 'shell-command)
               #'herdr-agent-tests--unexpected-cli)
              ((symbol-function 'call-process-shell-command)
               #'herdr-agent-tests--unexpected-cli))
      (dolist (kind '("claude" "pi" "codex"))
        (dolist (reference '(nil ""))
          (push (condition-case error
                    (progn
                      (herdr-agent-resume kind "review" reference)
                      '(returned))
                  (error error))
                conditions)))
      (push (condition-case error
                (progn
                  (herdr-agent-start "aider" "review")
                  '(returned))
              (error error))
            conditions)
      (should (equal (mapcar #'car (nreverse conditions))
                     '(user-error user-error user-error user-error
                       user-error user-error herdr-error)))
      (should-not starts)
      (should-not server-starts))))

