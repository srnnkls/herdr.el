(ert-deftest herdr-agent-shared-server-key-survives-a-missing-symlinked-parent ()
  (let* ((root (make-temp-file "herdr-agent-key" t))
         (real-root (expand-file-name "real" root))
         (alias-root (expand-file-name "alias" root))
         (real-parent (expand-file-name "socket-parent" real-root))
         (alias-socket (expand-file-name "herdr.sock"
                                         (expand-file-name "socket-parent" alias-root)))
         (real-socket (expand-file-name "herdr.sock" real-parent)))
    (unwind-protect
        (progn
          (make-directory real-root t)
          (make-symbolic-link real-root alias-root)
          (let ((herdr-socket-path alias-socket))
            (let ((before (herdr-server-key)))
              (make-directory real-parent t)
              (let ((expected (file-truename real-socket)))
                (should (equal before expected))
                (should (equal (herdr-server-key) expected))
                (let ((herdr-socket-path real-socket))
                  (should (equal (herdr-server-key) expected)))
                (let* ((target (expand-file-name "linked.sock" real-root))
                       (alias (expand-file-name "linked-alias.sock" real-root))
                       (before nil))
                  (make-symbolic-link target alias)
                  (let ((herdr-socket-path alias))
                    (setq before (herdr-server-key)))
                  (make-empty-file target)
                  (let ((expected-target (file-truename target)))
                    (should (equal before expected-target))
                    (let ((herdr-socket-path alias))
                      (should (equal (herdr-server-key) expected-target)))
                    (let ((herdr-socket-path target))
                      (should (equal (herdr-server-key) expected-target)))))))))
      (delete-directory root t))))

(ert-deftest herdr-agent-adoption-separates-same-label-terminal-on-explicit-servers ()
  (let* ((herdr-agent-harnesses
          (herdr-agent-tests--with-adapter "claude" nil))
         (root (make-temp-file "herdr-agent-servers" t))
         (socket-a (expand-file-name "a/herdr.sock" root))
         (socket-b (expand-file-name "b/herdr.sock" root))
         server-a server-b
         (attachments nil)
         (routed nil)
         first-buffer second-buffer first second)
    (unwind-protect
        (progn
          (make-directory (file-name-directory socket-a) t)
          (make-directory (file-name-directory socket-b) t)
          (let ((herdr-socket-path socket-a))
            (setq server-a (herdr-server-key)))
          (let ((herdr-socket-path socket-b))
            (setq server-b (herdr-server-key)))
          (let ((herdr-attach-functions (list #'herdr-agent-attach-entry))
                (herdr-buffer-name-function
                 (lambda (label &optional _directory) (format "*herdr: %s*" label))))
            (cl-letf (((symbol-function 'herdr--terminal-exec)
                       (lambda (buffer &rest _)
                         (push herdr-socket-path routed)
                         (let ((process
                                (start-process (format "herdr-agent-%s" (buffer-name buffer))
                                               buffer "sleep" "30")))
                           (push (cons buffer process) attachments)
                           buffer))))
              (let ((herdr-socket-path socket-a))
                (setq first-buffer
                      (herdr-attach-entry
                       (herdr-agent-tests--agent "claude" "term-shared" "a:pane" "a"))))
              (let ((herdr-socket-path socket-b))
                (setq second-buffer
                      (herdr-attach-entry
                       (herdr-agent-tests--agent "claude" "term-shared" "b:pane" "b"))))
              (setq first (herdr-agent-find server-a "term-shared")
                    second (herdr-agent-find server-b "term-shared"))
              (should (buffer-live-p first-buffer))
              (should (buffer-live-p second-buffer))
              (should-not (eq first-buffer second-buffer))
              (should (equal (buffer-name first-buffer) "*herdr: review*"))
              (should (equal (buffer-name second-buffer) "*herdr: review<2>*"))
              (should (eq (herdr-agent-session-buffer first) first-buffer))
              (should (eq (herdr-agent-session-buffer second) second-buffer))
              (should (equal (buffer-local-value 'herdr-terminal-server-key first-buffer)
                             server-a))
              (should (equal (buffer-local-value 'herdr-terminal-server-key second-buffer)
                             server-b))
              (should (equal (nreverse routed) (list server-a server-b))))))
      (herdr-agent-tests--detach first)
      (herdr-agent-tests--detach second)
      (mapc #'herdr-agent-tests--dispose-attachment attachments)
      (delete-directory root t))))

(ert-deftest herdr-agent-start-in-pane-uses-returned-agent-identity-for-three-kinds ()
  (let* ((root (make-temp-file "herdr-agent-start" t))
         (server-key (file-truename (expand-file-name "herdr.sock" root)))
         (fixtures '(("claude" "pending-claude" "agent-claude")
                     ("pi" "pending-pi" "agent-pi")
                     ("codex" "pending-codex" "agent-codex")))
         (attachments nil)
         (subscription-processes nil)
         (starts nil)
         (adapted nil)
         sessions)
    (unwind-protect
        (let ((herdr-agent-harnesses
               (herdr-agent-tests--with-adapter
                "claude"
                (lambda (session phase &optional _context)
                  (when (eq phase :attached)
                    (push "claude" adapted)
                    (with-current-buffer (herdr-agent-session-buffer session)
                      (setq-local herdr-agent-tests--ide-state "claude")))))))
          (cl-letf (((symbol-function 'herdr-api-agent-start)
                     (lambda (kind name pane-id &rest arguments)
                       (push (list kind name pane-id arguments) starts)
                       (let ((fixture (assoc kind fixtures)))
                         `((agent . ,(herdr-agent-tests--agent
                                      kind (nth 2 fixture) pane-id "work"))
                           (argv . ("herdr" "agent" ,kind))))))
                    ((symbol-function 'herdr-attach-terminal)
                     (lambda (terminal-id &rest _)
                       (let ((attachment
                              (herdr-agent-tests--attachment terminal-id terminal-id)))
                         (push attachment attachments)
                         (car attachment))))
                    ((symbol-function 'herdr-subscribe)
                     (lambda (&rest _)
                       (let ((process
                              (start-process "herdr-agent-subscription" nil "sleep" "30")))
                         (push process subscription-processes)
                         process))))
            (dolist (fixture fixtures)
              (pcase-let ((`(,kind ,provisional ,final) fixture))
                (let ((session
                       (herdr-agent-start-in-pane
                        kind "review"
                        (herdr-agent-tests--pane kind provisional
                                                 (concat kind ":pane") "work")
                        :server-key server-key :args '())))
                  (push session sessions)
                  (should (process-live-p
                           (herdr-agent-session-attachment-process session)))
                  (should (equal (herdr-agent-session-key session)
                                 (cons server-key final)))
                  (should (eq (herdr-agent-find server-key final) session))
                  (should-not (herdr-agent-find server-key provisional))
                  (if (equal kind "claude")
                      (should (equal (buffer-local-value 'herdr-agent-tests--ide-state
                                                         (herdr-agent-session-buffer session))
                                     "claude"))
                    (should-not (local-variable-p 'herdr-agent-tests--ide-state
                                                  (herdr-agent-session-buffer session)))))))
            (should (equal (mapcar (lambda (call) (cl-subseq call 0 4))
                                   (nreverse starts))
                           '(("claude" "review" "claude:pane" (:args nil))
                             ("pi" "review" "pi:pane" (:args nil))
                             ("codex" "review" "codex:pane" (:args nil)))))
            (should (equal adapted '("claude")))))
      (mapc #'herdr-agent-tests--detach sessions)
      (mapc #'herdr-agent-tests--dispose-attachment attachments)
      (dolist (process subscription-processes)
        (when (process-live-p process)
          (delete-process process)))
      (remhash (herdr-agent--canonical-server-key server-key)
               herdr-agent--subscriptions)
      (delete-directory root t))))

(ert-deftest herdr-agent-start-in-pane-waits-for-a-new-shell ()
  (let* ((root (make-temp-file "herdr-agent-shell" t))
         (server-key (file-truename (expand-file-name "herdr.sock" root)))
         (attempts 0)
         (get-attempts 0)
         subscription-processes
         session)
    (unwind-protect
        (cl-letf (((symbol-function 'herdr-api-agent-start)
                   (lambda (_kind _name pane-id &rest _arguments)
                     (cl-incf attempts)
                     (if (= attempts 1)
                         (signal 'herdr-api-error
                                 '("agent_pane_busy"
                                   "agent target pane is not an available shell"))
                       (let ((agent (copy-tree
                                     (herdr-agent-tests--agent
                                      "codex" "term-codex" pane-id "work"))))
                         (setf (alist-get 'interactive_ready agent) nil
                               (alist-get 'agent_status agent) "unknown")
                         `((agent . ,agent))))))
                  ((symbol-function 'herdr-api-agent-get)
                   (lambda (&rest _)
                     (cl-incf get-attempts)
                     (if (= get-attempts 1)
                         (signal 'herdr-api-error
                                 '("agent_not_found" "agent target not found"))
                       (let ((agent (copy-tree
                                     (herdr-agent-tests--agent
                                      "codex" "term-codex" "codex:pane" "work"))))
                         (setf (alist-get 'interactive_ready agent) nil)
                         `((agent . ,agent))))))
                  ((symbol-function 'herdr-subscribe)
                   (lambda (&rest _)
                     (let ((process
                            (start-process "herdr-agent-subscription" nil "sleep" "30")))
                       (push process subscription-processes)
                       process)))
                  ((symbol-function 'sleep-for) #'ignore))
          (setq session
                (herdr-agent-start-in-pane
                 "codex" "review"
                 (herdr-agent-tests--pane "codex" "pending-codex"
                                          "codex:pane" "work")
                 :server-key server-key :args '() :attach nil :timeout-ms 1000))
          (should (= attempts 2))
          (should (= get-attempts 2))
          (should (eq (herdr-agent-session-state session) 'attached)))
      (herdr-agent-tests--detach session)
      (dolist (process subscription-processes)
        (when (process-live-p process)
          (delete-process process)))
      (remhash (herdr-agent--canonical-server-key server-key)
               herdr-agent--subscriptions)
      (delete-directory root t))))

(ert-deftest herdr-agent-adoption-attaches-off-screen-when-asked ()
  (let* ((herdr-agent-harnesses (herdr-agent-tests--with-adapter "claude" nil))
         (root (make-temp-file "herdr-agent-adoption-display" t))
         (server-key (expand-file-name "herdr.sock" root))
         (attachment nil)
         (displays nil)
         session)
    (unwind-protect
        (cl-letf (((symbol-function 'herdr-attach-terminal)
                   (cl-function
                    (lambda (terminal-id &key display &allow-other-keys)
                      (push display displays)
                      (setq attachment (herdr-agent-tests--attachment terminal-id terminal-id))
                      (car attachment)))))
          (setq session
                (herdr-agent-adopt '((agent . "claude") (terminal_id . "term-quiet")
                                     (cwd . "/tmp"))
                                   :server-key server-key :display nil))
          (should (eq (herdr-agent-session-state session) 'attached))
          (should (equal displays '(nil)))
          (herdr-agent-tests--detach session)
          (herdr-agent-tests--dispose-attachment attachment)
          (setq session
                (herdr-agent-adopt '((agent . "claude") (terminal_id . "term-shown")
                                     (cwd . "/tmp"))
                                   :server-key server-key))
          (should (equal displays '(t nil))))
      (herdr-agent-tests--detach session)
      (herdr-agent-tests--dispose-attachment attachment)
      (delete-directory root t))))

(ert-deftest herdr-agent-adoption-reuses-three-kinds-and-cleans-a-failed-attachment ()
  (let* ((herdr-agent-harnesses
          (herdr-agent-tests--with-adapter "claude" nil))
         (root (make-temp-file "herdr-agent-adoption" t))
         (server-key (expand-file-name "herdr.sock" root))
         (fixtures '(("claude" . "term-claude")
                     ("pi" . "term-pi")
                     ("codex" . "term-codex")))
         (attachments nil)
         (attachment-count 0)
         sessions)
    (unwind-protect
        (cl-letf (((symbol-function 'herdr-api-agent-start)
                   (lambda (&rest _) (error "adoption must not launch an agent")))
                  ((symbol-function 'herdr-attach-terminal)
                   (lambda (terminal-id &rest _)
                     (cl-incf attachment-count)
                     (if (equal terminal-id "term-failed")
                         (error "attachment creation failed")
                       (let ((attachment
                              (herdr-agent-tests--attachment terminal-id terminal-id)))
                         (push attachment attachments)
                         (car attachment))))))
          (dolist (fixture fixtures)
            (pcase-let ((`(,kind . ,terminal-id) fixture))
              (let* ((agent (herdr-agent-tests--agent kind terminal-id
                                                       (concat terminal-id ":pane") "work"))
                     (first (herdr-agent-adopt agent :server-key server-key))
                     (second (herdr-agent-adopt agent :server-key server-key)))
                (push first sessions)
                (should (eq first second))
                (should (eq (herdr-agent-find server-key terminal-id) first)))))
          (let ((error
                 (should-error
                  (herdr-agent-adopt
                   (herdr-agent-tests--agent "pi" "term-failed" "failed:pane" "work")
                   :server-key server-key))))
            (should (equal (error-message-string error) "attachment creation failed")))
          (should (= attachment-count 4))
          (should-not (herdr-agent-find server-key "term-failed"))
          (let* ((terminal-id "term-adopted-retry")
                 (canonical-server-key (herdr-agent--canonical-server-key server-key))
                 (adapter-cleanup-fault t)
                 (operations nil)
                 adopted-session adoption-error session)
            (cl-letf (((symbol-function 'herdr-agent--run-adapter)
                       (lambda (candidate phase &optional _context)
                         (pcase phase
                           (:adopted
                            (setq adopted-session candidate)
                            (push 'adopted operations)
                            (error "adapter adoption failed"))
                           (:detach
                            (push 'detach operations)
                            (when adapter-cleanup-fault
                              (error "adapter cleanup failed")))))))
              (setq adoption-error
                    (condition-case error-data
                        (progn
                          (herdr-agent-adopt
                           (herdr-agent-tests--agent
                            "claude" terminal-id "adopted:pane" "work")
                           :server-key server-key)
                          'returned)
                      (error error-data))
                    session (herdr-agent-find canonical-server-key terminal-id))
            (should (equal (error-message-string adoption-error)
                           "adapter adoption failed"))
            (should session)
            (should (eq session adopted-session))
            (should (eq (herdr-agent-session-state session) 'detaching))
            (should (equal (herdr-agent-session-cleanup session) '(adapter)))
            (should-not (herdr-agent-session-ownership session))
            (setq operations nil
                  adapter-cleanup-fault nil)
            (herdr-agent-detach session)
            (should (equal (reverse operations) '(detach)))
            (should (eq (herdr-agent-session-state session) 'stopped))
            (should-not (herdr-agent-find canonical-server-key terminal-id)))))
      (mapc #'herdr-agent-tests--detach sessions)
      (mapc #'herdr-agent-tests--dispose-attachment attachments)
      (delete-directory root t))))

(ert-deftest herdr-agent-event-subscriptions-route-data-per-server-and-repair-moves ()
  (let* ((root (make-temp-file "herdr-agent-events" t))
         (socket-a (expand-file-name "a/herdr.sock" root))
         (socket-b (expand-file-name "b/herdr.sock" root))
         server-a server-b
         (attachments nil)
         (callbacks (make-hash-table :test #'equal))
         (subscriptions nil)
         (subscription-processes nil)
         (operations nil)
         (prepared-subscription-states nil)
         (startup-count 0)
         (attached-count 0)
         (attached-terminals nil)
         (herdr-agent-harnesses
          (herdr-agent-tests--with-adapter
           "pi"
           (lambda (session phase &optional _context)
             (pcase phase
               (:prepare
                (let ((cached (gethash server-a herdr-agent--subscriptions)))
                  (push (list (length cached) (cl-every #'process-live-p cached))
                        prepared-subscription-states))
                (push 'prepare operations)
                nil)
               (:attached
                (should (stringp (herdr-agent-session-terminal session)))
                (should (eq (herdr-agent-session-state session) 'starting))
                (cl-incf attached-count)
                (push (herdr-agent-session-terminal session) attached-terminals)
                (push 'attached operations))
               (:status '((integration_status . "published")))))))
         session-a session-b alias-session startup-session nil-subscription-session)
    (unwind-protect
        (progn
          (make-directory (file-name-directory socket-a) t)
          (make-directory (file-name-directory socket-b) t)
          (let ((herdr-socket-path socket-a))
            (setq server-a (herdr-server-key)))
          (let ((herdr-socket-path socket-b))
            (setq server-b (herdr-server-key)))
          (cl-letf (((symbol-function 'herdr-attach-terminal)
                     (lambda (terminal-id &rest _)
                       (let ((attachment
                              (herdr-agent-tests--attachment terminal-id terminal-id)))
                         (push attachment attachments)
                         (car attachment))))
                    ((symbol-function 'herdr-subscribe)
                     (lambda (types callback &rest _)
                       (should (listp types))
                       (push 'subscribe operations)
                       (push (cons (herdr-server-key) types) subscriptions)
                       (dolist (type types)
