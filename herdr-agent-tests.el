                   :server-key server-a)
                  session-b
                  (herdr-agent-adopt
                   (herdr-agent-tests--agent "pi" "term-shared" "b:only" "b")
                   :server-key server-b))
            (let ((herdr-socket-path socket-a)) (herdr-agent-subscribe server-a))
            (let ((herdr-socket-path socket-b)) (herdr-agent-subscribe server-b))
            (dolist (server-key (list server-a server-b))
