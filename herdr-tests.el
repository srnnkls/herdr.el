(ert-deftest herdr-agent-attachment-runs-the-registered-adapter ()
  (let* ((terminal-id "term-claude")
         (entry `((agent . "claude")
                  (cwd . ,default-directory)
                  (terminal_id . ,terminal-id)
                  (agent_status . "idle")))
         (buffer (generate-new-buffer " *herdr: claude*"))
         (process (start-process "herdr-claude" buffer "sleep" "30"))
         (herdr-agent--adapters nil)
         phases session
         (adapter (lambda (_session phase &optional _context)
                    (push phase phases))))
    (herdr-agent-register-adapter "claude" adapter)
    (unwind-protect
        (cl-letf (((symbol-function 'herdr-attach-terminal)
                   (lambda (&rest _) buffer)))
          (should (eq (herdr-attach-entry entry) buffer))
          (setq session (herdr-agent-find (herdr-server-key) terminal-id))
          (should session)
          (should (equal (nreverse phases) '(:adopted :attached))))
      (when session
        (herdr-agent-detach session))
      (herdr-agent-unregister-adapter "claude" adapter)
      (when (process-live-p process)
        (delete-process process))
      (when (buffer-live-p buffer)
        (kill-buffer buffer)))))

