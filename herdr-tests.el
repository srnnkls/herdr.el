      (let* ((data '((pane_id . "w1:t1:p1") (terminal_id . "term-1")))
             (received nil)
             (herdr-socket-path
              (herdr-tests--start-server
               (lambda (_request)
                 `((event . "pane.updated") (data . ,data))))))
        (herdr-subscribe '("pane.updated") (lambda (event) (setq received event)))
